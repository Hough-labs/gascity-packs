 setup_noid() { echo 'unset BEADS_ACTOR' >"$1/env"; }
 setup_drain() { echo '{"action":"drain"}' >"$1/hook"; }
 setup_empty() { echo '{}' >"$1/hook"; }
 setup_garbage() { echo 'not json' >"$1/hook"; }
+setup_nonobject() { echo '[]' >"$1/hook"; }
+setup_blank() { : >"$1/hook"; }
+setup_garbageflaky() {
