+    [ "$RC" -eq 0 ] || fail "new-branch stub: want exit 0, got $RC: $(cat "$CASE/out") $(cat "$CASE/err")"
+    called 'git fetch origin release/2.x'
+    called 'git checkout -b polecat/w-3 refs/remotes/origin/release/2.x'
