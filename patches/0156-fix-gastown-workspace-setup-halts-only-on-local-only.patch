From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Tue, 13 Oct 2026 20:56:57 -0400
Subject: [PATCH 156/178] fix(gastown): workspace-setup halts only on
 local-only base commits, not a stale local ref (gcp-19hoi)

On 2026-10-13 every gascity-packs polecat halted at workspace-setup with
halt_reason=base_branch_diverged. The rig root's local integration was a stale
pre-restack ref after the 10-10 force-push restack: not an ancestor of
origin/integration, yet holding nothing local-only (its old tip is on
origin/archive/integration-v0.4.0). The ancestry check stated its reason as "a
base that has advanced only locally" but fired on a merely stale copy too, and
the local copy never feeds the fork point when origin has the base. Every future
restack would have stranded the pool the same way.

Inside the "local is not an ancestor of origin" arm, count the commits local
holds that no remote ref does (git rev-list --count BASE_LOCAL --not --remotes).
STOP, with the same halt_reason, only when that is non-zero or the count itself
fails; when it is 0, print a note and branch from origin. The block is wrapped
in GUARD_BEGIN/GUARD_END base-resolve markers so a test can extract it verbatim,
and the prose and STOP text now say "local-only commits". The local-only path and
everything outside the block are untouched.

New test_polecat_base_resolution.sh runs the extracted block against a scratch
origin and clone per case: A stale (only case that changes), B stale_unarchived,
C ahead, D in_sync, E revlist_error. Red-checked against the old formula with
markers only: A fails, B-E pass.

Out of scope: worktree-setup.sh base selection (gcp-8v32), which should copy this
check.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 gastown/formulas/mol-polecat-work.toml        |  30 ++-
 gastown/tests/test_polecat_base_resolution.sh | 231 ++++++++++++++++++
 2 files changed, 251 insertions(+), 10 deletions(-)
 create mode 100755 gastown/tests/test_polecat_base_resolution.sh

diff --git a/gastown/formulas/mol-polecat-work.toml b/gastown/formulas/mol-polecat-work.toml
index 4b83e64f..14cfc5df 100644
--- a/gastown/formulas/mol-polecat-work.toml
+++ b/gastown/formulas/mol-polecat-work.toml
@@ -105,10 +105,14 @@ substituting a different base, because silently falling back to the
 repo default is how a rig pinned to an integration branch got polecats
 branched off main (gas-e6r).
 
-When the base exists in both places, the local copy must not be ahead of
-origin: a base that has advanced only locally is not the base the
-refinery will merge against, and branching from either side silently
-picks a different fork point. Ancestry-check instead of guessing.
+When the base exists in both places, the local copy must not carry
+local-only commits: a base that has advanced only locally is not the base
+the refinery will merge against, and branching from either side silently
+picks a different fork point. Ancestry-check, then count the commits the
+local copy holds that no remote ref does, instead of guessing. A local
+copy that is merely stale — behind a force-pushed origin, with every
+commit still on some remote branch — holds nothing that would be lost, so
+the step branches from origin rather than halting the pool.
 
 Both arms name fully-qualified refs. Git resolves `refs/tags/<name>`
 before `refs/heads/<name>`, so a bare branch name lets a same-named tag
@@ -122,17 +126,22 @@ base selection of its own; keep the two halves in step, or they will
 disagree about what "the base" means.
 
 ```bash
+# GUARD_BEGIN base-resolve
 BASE_REMOTE="refs/remotes/origin/{{base_branch}}"
 BASE_LOCAL="refs/heads/{{base_branch}}"
 WITNESS_TARGET="${GC_RIG:+$GC_RIG/}{{binding_prefix}}witness"
 if git show-ref --verify --quiet "$BASE_REMOTE"; then
     if git show-ref --verify --quiet "$BASE_LOCAL" && ! git merge-base --is-ancestor "$BASE_LOCAL" "$BASE_REMOTE"; then
-        echo "STOP: local {{base_branch}} is ahead of, or diverged from, the copy on origin."
-        echo "Reconcile or push {{base_branch}} first; do not branch from a stale base."
-        gc bd update "$WORK_BEAD_ID" --set-metadata halt_reason=base_branch_diverged
-        gc mail send "$WITNESS_TARGET" -s "polecat halted: base_branch_diverged ($WORK_BEAD_ID)" -m "Local {{base_branch}} is not an ancestor of the copy on origin; $WORK_BEAD_ID cannot pick a fork point. Reconcile the branch."
-        gc runtime drain-ack
-        exit 1
+        LOCAL_ONLY=$(git rev-list --count "$BASE_LOCAL" --not --remotes) || LOCAL_ONLY=err
+        if [ "$LOCAL_ONLY" != "0" ]; then
+            echo "STOP: local {{base_branch}} has local-only commits that are not on origin or any other remote branch."
+            echo "Reconcile or push {{base_branch}} first; do not branch from a stale base."
+            gc bd update "$WORK_BEAD_ID" --set-metadata halt_reason=base_branch_diverged
+            gc mail send "$WITNESS_TARGET" -s "polecat halted: base_branch_diverged ($WORK_BEAD_ID)" -m "Local {{base_branch}} has local-only commits (count: $LOCAL_ONLY) that are not an ancestor of the copy on origin and are on no remote branch; $WORK_BEAD_ID cannot pick a fork point. Reconcile the branch."
+            gc runtime drain-ack
+            exit 1
+        fi
+        echo "note: local {{base_branch}} is stale (0 commits off-remote); branching from origin"
     fi
     BASE_REF="$BASE_REMOTE"    # preferred: freshly fetched, no local drift
 elif git show-ref --verify --quiet "$BASE_LOCAL"; then
@@ -147,6 +156,7 @@ else
     exit 1
 fi
 gc bd update "$WORK_BEAD_ID" --set-metadata base_ref="$BASE_REF"
+# GUARD_END base-resolve
 ```
 
 The STOP arms stamp `halt_reason` and mail the witness on the way out —
diff --git a/gastown/tests/test_polecat_base_resolution.sh b/gastown/tests/test_polecat_base_resolution.sh
new file mode 100755
index 00000000..5d01e506
--- /dev/null
+++ b/gastown/tests/test_polecat_base_resolution.sh
@@ -0,0 +1,231 @@
+#!/usr/bin/env bash
+# Executable reproduction of the pool-wide halt in gcp-19hoi.
+#
+# On 2026-10-13 every gascity-packs polecat halted at workspace-setup with
+# halt_reason=base_branch_diverged. The rig root's LOCAL integration was a stale
+# pre-restack ref: after the 10-10 force-push restack its old tip was not an
+# ancestor of origin/integration, so the ancestry check STOPped — yet nothing was
+# local-only (the old tip lives on origin/archive/integration-v0.4.0). The check
+# fires on a merely STALE local copy, which is wider than its stated reason: "a
+# base that has advanced only locally". Every future restack would strand the
+# pool the same way.
+#
+# These tests extract the base-resolution block out of mol-polecat-work verbatim
+# (between the GUARD_BEGIN/GUARD_END base-resolve markers) and run it against a
+# scratch bare origin plus clone per case, with a stubbed `gc` that logs its
+# argv. Only case A changes with the fix; B, C and E pin the STOP that must
+# survive, D the in-sync path.
+#
+#   A stale             local tip is not an ancestor of origin but is on a remote
+#                       branch (archived)      -> proceed from origin
+#   B stale_unarchived  same, but on no remote -> STOP
+#   C ahead             local holds an unpushed commit -> STOP
+#   D in_sync           local == origin        -> proceed
+#   E revlist_error     the commit count itself fails -> STOP (fail closed)
+#
+# FORMULA overrides the formula under test, for a red-check against an older one.
+# Assertions grep for literal shell snippets, so single-quoted `$VAR` is the point.
+# shellcheck disable=SC2016
+set -euo pipefail
+
+ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+FORMULA="${FORMULA:-$ROOT/gastown/formulas/mol-polecat-work.toml}"
+REAL_GIT=$(command -v git)
+
+# A host global git config (tag signing, hooks path, templates) must not reach
+# the scratch repos.
+export GIT_CONFIG_GLOBAL=/dev/null
+export GIT_CONFIG_SYSTEM=/dev/null
+export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.invalid
+export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.invalid
+
+fail() {
+    echo "FAIL: $*" >&2
+    exit 1
+}
+
+# extract_block pulls the base resolution verbatim out of the formula, so the
+# code under test is the code that ships. A drifted or deleted block fails here
+# rather than passing against a stale copy. The formula's template variables are
+# rendered the way the pack renders them.
+extract_block() {
+    local out="$1"
+    [[ "$(grep -c '^# GUARD_BEGIN base-resolve$' "$FORMULA")" == 1 ]] ||
+        fail "expected exactly one '# GUARD_BEGIN base-resolve' in $FORMULA"
+    [[ "$(grep -c '^# GUARD_END base-resolve$' "$FORMULA")" == 1 ]] ||
+        fail "expected exactly one '# GUARD_END base-resolve' in $FORMULA"
+    awk '/^# GUARD_BEGIN base-resolve$/{f=1} /^# GUARD_END base-resolve$/{f=0} f' "$FORMULA" |
+        sed -e 's/{{base_branch}}/integration/g' -e 's/{{binding_prefix}}/gastown./g' >"$out"
+    [[ -s "$out" ]] || fail "could not extract the base-resolve block from $FORMULA"
+    grep -F 'halt_reason=base_branch_diverged' "$out" >/dev/null ||
+        fail "extracted block does not contain the diverged STOP"
+    ! grep -F '{{' "$out" >/dev/null || fail "extracted block has an unrendered template variable"
+    bash -n "$out" || fail "extracted block is not valid shell"
+}
+
+# write_gc_stub records every call; the block only writes, never reads.
+write_gc_stub() {
+    local bin="$1"
+    mkdir -p "$bin"
+    cat >"$bin/gc" <<'SH'
+#!/usr/bin/env bash
+printf '%s\n' "$*" >>"$GC_CALLS"
+SH
+    chmod +x "$bin/gc"
+}
+
+# write_git_wrapper makes `git rev-list` fail and passes everything else through.
+write_git_wrapper() {
+    local bin="$1"
+    cat >"$bin/git" <<SH
+#!/usr/bin/env bash
+if [ "\${1-}" = rev-list ]; then
+    echo "fatal: simulated rev-list failure" >&2
+    exit 128
+fi
+exec "$REAL_GIT" "\$@"
+SH
+    chmod +x "$bin/git"
+}
+
+# commit <repo> <file> makes one commit that touches <file>.
+commit() {
+    local repo="$1" file="$2"
+    echo "$file $RANDOM" >>"$repo/$file"
+    "$REAL_GIT" -C "$repo" add "$file"
+    "$REAL_GIT" -C "$repo" -c commit.gpgsign=false commit -q -m "$file"
+}
+
+# new_case builds a fresh scratch bare origin and clone with c1 <- c2 on
+# integration, pushed, and the clone's local integration at c2. It prints the
+# scratch dir; the clone is $dir/clone.
+new_case() {
+    local dir
+    dir=$(mktemp -d)
+    mkdir -p "$dir/bin"
+    write_gc_stub "$dir/bin"
+    extract_block "$dir/block.sh"
+    : >"$dir/calls.log"
+
+    "$REAL_GIT" init -q --bare -b integration "$dir/origin.git"
+    "$REAL_GIT" init -q -b integration "$dir/seed"
+    commit "$dir/seed" c1
+    commit "$dir/seed" c2
+    "$REAL_GIT" -C "$dir/seed" remote add origin "$dir/origin.git"
+    "$REAL_GIT" -C "$dir/seed" push -q origin integration
+    "$REAL_GIT" clone -q "$dir/origin.git" "$dir/clone"
+    printf '%s' "$dir"
+}
+
+# restack force-moves origin/integration to a commit that does not contain the
+# old tip, then refreshes the clone the way `git fetch --prune origin` does at
+# the top of workspace-setup. When <archive> is "archive" the old tip is first
+# kept on a second remote branch, the way the restack archives it.
+restack() {
+    local dir="$1" archive="$2"
+    if [[ "$archive" == archive ]]; then
+        "$REAL_GIT" -C "$dir/seed" push -q origin integration:refs/heads/archive/integration
+    fi
+    "$REAL_GIT" -C "$dir/seed" checkout -q -B restacked integration~1
+    commit "$dir/seed" n1
+    "$REAL_GIT" -C "$dir/seed" push -q --force origin restacked:integration
+    "$REAL_GIT" -C "$dir/clone" fetch -q --prune origin
+}
+
+# run_block executes the block with the inputs workspace-setup binds beforehand,
+# then echoes BASE_REF. A STOP exits before that line, so its absence is the
+# assertion that the polecat never reached the work. Sets RC and OUT.
+run_block() {
+    local dir="$1" path_prefix="${2-$1/bin}"
+    cat >"$dir/harness.sh" <<HARNESS
+WORK_BEAD_ID="gcp-test1"
+GC_RIG="gascity-packs"
+HARNESS
+    cat "$dir/block.sh" >>"$dir/harness.sh"
+    echo 'echo "BASE_REF=$BASE_REF"' >>"$dir/harness.sh"
+
+    set +e
+    OUT=$(cd "$dir/clone" && GC_CALLS="$dir/calls.log" PATH="$path_prefix:$PATH" bash "$dir/harness.sh" 2>&1)
+    RC=$?
+    set -e
+}
+
+assert_halted() {
+    local dir="$1" label="$2"
+    [[ "$RC" == 1 ]] || fail "$label: expected exit 1 (STOP), got $RC: $OUT"
+    grep -F 'halt_reason=base_branch_diverged' "$dir/calls.log" >/dev/null ||
+        fail "$label: STOP did not stamp halt_reason=base_branch_diverged: $(cat "$dir/calls.log")"
+    grep -F 'runtime drain-ack' "$dir/calls.log" >/dev/null ||
+        fail "$label: STOP did not drain: $(cat "$dir/calls.log")"
+    ! grep -F 'BASE_REF=' <<<"$OUT" >/dev/null ||
+        fail "$label: halted but still fell through to the work: $OUT"
+}
+
+assert_branches_from_origin() {
+    local dir="$1" label="$2"
+    [[ "$RC" == 0 ]] || fail "$label: expected exit 0, got $RC: $OUT"
+    grep -Fx 'BASE_REF=refs/remotes/origin/integration' <<<"$OUT" >/dev/null ||
+        fail "$label: did not branch from origin: $OUT"
+    ! grep -F 'halt_reason=base_branch_diverged' "$dir/calls.log" >/dev/null ||
+        fail "$label: stamped a halt it should not have: $(cat "$dir/calls.log")"
+    ! grep -F 'runtime drain-ack' "$dir/calls.log" >/dev/null ||
+        fail "$label: drained although it proceeded: $(cat "$dir/calls.log")"
+}
+
+# A: the 2026-10-13 incident. Local integration is the pre-restack tip, which
+# origin keeps on an archive branch; nothing is local-only.
+test_case_A_stale() {
+    local dir
+    dir=$(new_case)
+    restack "$dir" archive
+    run_block "$dir"
+    assert_branches_from_origin "$dir" "A stale"
+    grep -F 'note: local integration is stale (0 commits off-remote); branching from origin' <<<"$OUT" >/dev/null ||
+        fail "A stale: did not say why it proceeded: $OUT"
+}
+
+# B: stale too, but the old tip is on no remote branch (only a tag, or nothing).
+# Branching from origin would orphan those commits, so this must still STOP.
+test_case_B_stale_unarchived() {
+    local dir
+    dir=$(new_case)
+    restack "$dir" no-archive
+    run_block "$dir"
+    assert_halted "$dir" "B stale_unarchived"
+}
+
+# C: local integration holds an unpushed commit: the original reason for the check.
+test_case_C_ahead() {
+    local dir
+    dir=$(new_case)
+    commit "$dir/clone" local-only
+    run_block "$dir"
+    assert_halted "$dir" "C ahead"
+}
+
+# D: in sync.
+test_case_D_in_sync() {
+    local dir
+    dir=$(new_case)
+    run_block "$dir"
+    assert_branches_from_origin "$dir" "D in_sync"
+}
+
+# E: case A's repo, but the commit count itself fails. An answer nobody verified
+# is not proof that nothing is local-only, so the block must fail closed.
+test_case_E_revlist_error() {
+    local dir
+    dir=$(new_case)
+    restack "$dir" archive
+    write_git_wrapper "$dir/bin"
+    run_block "$dir"
+    assert_halted "$dir" "E revlist_error"
+}
+
+test_case_A_stale
+test_case_B_stale_unarchived
+test_case_C_ahead
+test_case_D_in_sync
+test_case_E_revlist_error
+
+echo "polecat base-resolution tests passed"
-- 
