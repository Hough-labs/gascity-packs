-"$MERGE_PUSH" --work "$WORK" >"$MP_LOG" 2>&1
+# A batch manifest of 2+ members, written by find-work and completed by rebase's
+# stack block, makes this the batch lane. No manifest, an unparseable one or one
+# member is the single-bead lane, exactly as without batching.
+BATCH_DIR=$(git rev-parse --git-dir 2>/dev/null) || BATCH_DIR=""
+BATCH_N=0
+if [ -n "$BATCH_DIR" ] && [ -f "$BATCH_DIR/refinery-batch.json" ]; then
+    BATCH_N=$(jq -r '.members | if type == "array" then length else 0 end' "$BATCH_DIR/refinery-batch.json" 2>/dev/null)
+    case "$BATCH_N" in ''|*[!0-9]*) BATCH_N=0 ;; esac
+fi
