+
+def test_detector_covers_flag_forms_and_prose() -> None:
+    fixture = Path("fixture.txt")
+
+    assert molecule_query_violations(fixture, "gc bd list --type=molecule --limit=0")
+    assert molecule_query_violations(fixture, "gc bd list --type molecule --limit=0")
