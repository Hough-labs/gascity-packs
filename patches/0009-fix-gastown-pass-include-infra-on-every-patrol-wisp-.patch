+    )
+    assert not molecule_query_violations(
+        fixture, "gc bd list --type=molecule --include-infra --limit=0"
+    )
+    assert not molecule_query_violations(
+        fixture, "gc bd list --type=molecule \\\n  --include-infra --json"
