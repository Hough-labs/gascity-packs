From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Tue, 13 Oct 2026 20:19:51 -0400
Subject: [PATCH 155/169] fix(gastown): shutdown-dance progress probe parses
 bead timestamps on macOS (gcp-uijsa)

The progress probe in mol-shutdown-dance ages the target's claimed bead with
`date -u -d`, which is GNU only. On macOS the call fails, the age is never
numeric, progress is always "unknown", and every warrant is pardoned and
escalated to the mayor. A stuck session is then never reaped by warrant.

The probe now tries GNU `date -d` first and BSD `date -j -f` second, after
stripping fractional seconds and spelling a trailing Z as +0000, the same
shape as ts_epoch in witness-heartbeat-check.sh. An unparseable value still
yields progress_signal=unknown. The sed program carries no backslash because
the probe lives in a TOML basic string.

New test_shutdown_progress_probe_dates.sh extracts the probe, stubs gc, and
pins an aged bead to progress=none, a recent bead and a fractional-second
bead to progress=bead, and an unparseable one to unknown. It exits 1 against
the previous formula on darwin and 0 with this change.

test_witness_heartbeat_check.sh built its fixtures with GNU `date -d @N`; they
now fall back to `date -r N`. Past that, the file had a second, platform
independent failure: its blanket "no GC_PACK_DIR in mol-deacon-patrol" check
has been red since gcp-oo0v gave the dolt-push-divergence step a documented
GC_PACK_DIR fallback. The check is scoped to the step that runs the heartbeat
check, which is the rule it was written to pin.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 gastown/formulas/mol-shutdown-dance.toml      |   8 +-
 .../test_shutdown_progress_probe_dates.sh     | 128 ++++++++++++++++++
 gastown/tests/test_witness_heartbeat_check.sh |  33 ++++-
 3 files changed, 162 insertions(+), 7 deletions(-)
 create mode 100644 gastown/tests/test_shutdown_progress_probe_dates.sh

diff --git a/gastown/formulas/mol-shutdown-dance.toml b/gastown/formulas/mol-shutdown-dance.toml
index 5a5e0254..7e62e84d 100644
--- a/gastown/formulas/mol-shutdown-dance.toml
+++ b/gastown/formulas/mol-shutdown-dance.toml
@@ -438,7 +438,13 @@ if [ -n "$target_bead" ] && [ -n "${bead_json:-}" ]; then
 
   echo "target_bead=$target_bead updated_at=$bead_updated artifact_dir=$artifact_dir"
   # Bead moved within the 7-minute interrogation window (60s+120s+240s = 420s)?
-  bead_epoch="$(date -u -d "$bead_updated" +%s 2>/dev/null)" || {
+  # GNU `date -d` first, BSD `date -j -f` second: the fleet includes macOS,
+  # where -d is not a date. BSD cannot parse fractional seconds or a bare Z,
+  # so strip the one and spell the other +0000. The sed program has no
+  # backslash on purpose: this is a TOML basic string.
+  bead_norm="$(printf '%s' "$bead_updated" | sed -E 's/[.][0-9]+//; s/Z$/+0000/')"
+  bead_epoch="$(date -u -d "$bead_updated" +%s 2>/dev/null)" ||
+  bead_epoch="$(date -u -j -f '%Y-%m-%dT%H:%M:%S%z' "$bead_norm" +%s 2>/dev/null)" || {
     bead_epoch=0
     progress=unknown
   }
diff --git a/gastown/tests/test_shutdown_progress_probe_dates.sh b/gastown/tests/test_shutdown_progress_probe_dates.sh
new file mode 100644
index 00000000..9fca3ced
--- /dev/null
+++ b/gastown/tests/test_shutdown_progress_probe_dates.sh
@@ -0,0 +1,128 @@
+#!/usr/bin/env bash
+# The shutdown-dance progress probe decides whether a warrant target is still
+# working by aging its claimed bead's updated_at. That parse used GNU
+# `date -u -d` alone, which BSD date (macOS) rejects: the age came out unknown
+# for every bead, so every warrant was pardoned and escalated and a stuck
+# session was never reaped. These cases pin the parse to a numeric age on the
+# host that runs them.
+set -euo pipefail
+
+ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+SHUTDOWN_FORMULA="$ROOT/gastown/formulas/mol-shutdown-dance.toml"
+
+fail() {
+    echo "FAIL: $*" >&2
+    exit 1
+}
+
+physical_mktemp_dir() {
+    local dir
+    dir=$(mktemp -d) || return 1
+    (cd "$dir" && pwd -P)
+}
+
+extract_shutdown_probe() {
+    local output=$1
+    python3 - "$SHUTDOWN_FORMULA" "$output" <<'PY'
+import pathlib
+import sys
+import tomllib
+
+formula_path = pathlib.Path(sys.argv[1])
+output_path = pathlib.Path(sys.argv[2])
+with formula_path.open("rb") as handle:
+    formula = tomllib.load(handle)
+execute = next(step for step in formula["steps"] if step["id"] == "execute")
+description = execute["description"]
+begin = description.index("# BEGIN SHUTDOWN_PROGRESS_PROBE")
+end = description.index("# END SHUTDOWN_PROGRESS_PROBE", begin)
+block = description[begin:end].splitlines()[1:]
+output_path.write_text("\n".join(block) + "\n", encoding="utf-8")
+PY
+}
+
+# bead_timestamp <seconds-ago> [fraction] — RFC3339 UTC, the shape gc emits for
+# a bead's updated_at. Python rather than date: the point of this file is that
+# the probe's own date parsing must not be what builds the fixture.
+bead_timestamp() {
+    python3 - "$1" "${2:-}" <<'PY'
+import datetime
+import sys
+
+ago = int(sys.argv[1])
+fraction = sys.argv[2]
+moment = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=ago)
+print(moment.strftime("%Y-%m-%dT%H:%M:%S") + fraction + "Z")
+PY
+}
+
+# run_probe <bead-updated-at> — runs the extracted probe against a target whose
+# only claimed bead carries that updated_at, and prints the probe's output.
+run_probe() {
+    local updated_at=$1 tmp probe bd_subcommand
+    tmp=$(physical_mktemp_dir)
+    trap 'rm -rf "$tmp"' RETURN
+    probe="$tmp/probe.sh"
+    bd_subcommand=$(printf '%s%s' b d)
+    extract_shutdown_probe "$probe"
+
+    (
+        # The sourced probe calls gc and reads $target; shellcheck cannot see it.
+        # shellcheck disable=SC2329
+        gc() {
+            case "$*" in
+                "session list --state=all --json")
+                    printf '%s\n' '{"sessions":[{"id":"session-1","name":"demo/gastown.worker","template":"demo/gastown.polecat","rig":"demo","alias":"demo/gastown.worker"}]}'
+                    ;;
+                "$bd_subcommand --rig demo list --status=in_progress --json --limit=0")
+                    printf '%s\n' '[{"id":"demo-b1","assignee":"demo/gastown.worker"}]'
+                    ;;
+                "$bd_subcommand --rig demo show demo-b1 --json")
+                    printf '[{"id":"demo-b1","updated_at":"%s","metadata":{}}]\n' "$updated_at"
+                    ;;
+                *)
+                    return 1
+                    ;;
+            esac
+        }
+        # shellcheck disable=SC2034
+        target="demo/gastown.worker"
+        # shellcheck source=/dev/null
+        source "$probe"
+    )
+}
+
+test_aged_bead_reads_as_no_progress() {
+    local output
+    output=$(run_probe "$(bead_timestamp 3600)")
+    printf '%s\n' "$output" | grep -q '^progress_signal=none$' ||
+        fail "a bead untouched for an hour should read progress=none, got: $output"
+}
+
+test_recent_bead_reads_as_bead_progress() {
+    local output
+    output=$(run_probe "$(bead_timestamp 60)")
+    printf '%s\n' "$output" | grep -q '^progress_signal=bead$' ||
+        fail "a bead touched a minute ago should read progress=bead, got: $output"
+}
+
+test_fractional_seconds_parse() {
+    local output
+    output=$(run_probe "$(bead_timestamp 60 .123456)")
+    printf '%s\n' "$output" | grep -q '^progress_signal=bead$' ||
+        fail "a fractional-second updated_at should parse and read progress=bead, got: $output"
+}
+
+test_unparseable_bead_timestamp_stays_unknown() {
+    local output
+    output=$(run_probe "not-a-timestamp")
+    printf '%s\n' "$output" | grep -q '^progress_signal=unknown$' ||
+        fail "an unparseable updated_at should read progress=unknown, got: $output"
+}
+
+test_aged_bead_reads_as_no_progress
+test_recent_bead_reads_as_bead_progress
+test_fractional_seconds_parse
+test_unparseable_bead_timestamp_stays_unknown
+
+echo "shutdown progress probe date tests passed"
diff --git a/gastown/tests/test_witness_heartbeat_check.sh b/gastown/tests/test_witness_heartbeat_check.sh
index c03762d4..087f7f3a 100755
--- a/gastown/tests/test_witness_heartbeat_check.sh
+++ b/gastown/tests/test_witness_heartbeat_check.sh
@@ -42,10 +42,15 @@ run_check() {
     ERR=$(cat "$ERRFILE")
 }
 
+# Epoch seconds -> RFC3339 UTC. GNU `date -d @N` first, BSD `date -r N` second,
+# so the fixtures build on both hosts the script under test runs on.
+epoch_to_rfc3339() {
+    date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
+        date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ
+}
+
 ts_ago() {
-    # Seconds ago -> RFC3339 UTC. GNU date here; the script under test is what
-    # needs BSD portability, not this Linux-only CI test.
-    date -u -d "@$(( $(date -u +%s) - $1 ))" +%Y-%m-%dT%H:%M:%SZ
+    epoch_to_rfc3339 "$(( $(date -u +%s) - $1 ))"
 }
 
 tmp=$(mktemp -d)
@@ -119,7 +124,7 @@ test_fractional_seconds_parse() {
 }
 
 test_future_heartbeat_is_clock_skew_not_stale() {
-    run_check "$(printf '{"sessions":[{"id":"s1","name":"alpha/witness","rig":"alpha","state":"asleep","last_active":"%s","closed":false}]}' "$(date -u -d "@$(( $(date -u +%s) + 3600 ))" +%Y-%m-%dT%H:%M:%SZ)")"
+    run_check "$(printf '{"sessions":[{"id":"s1","name":"alpha/witness","rig":"alpha","state":"asleep","last_active":"%s","closed":false}]}' "$(epoch_to_rfc3339 "$(( $(date -u +%s) + 3600 ))")")"
     [ "$RC" -eq 0 ] || fail "a future heartbeat is skew, not staleness, got $RC ($OUT)"
     printf '%s' "$OUT" | grep -q '^fresh	alpha	alpha/witness	asleep	0	' ||
         fail "a future heartbeat should clamp to age 0, got: $OUT"
@@ -256,8 +261,24 @@ test_uses_no_bash4_only_constructs() {
 test_formula_dispatches_via_pack_command_without_agent_pack_env() {
     grep -Fqx 'GASTOWN_WITNESS_STALE_MIN={{witness_stale_min}} gc gastown witness-heartbeat-check' "$FORMULA" ||
         fail "health-scan must invoke the heartbeat check through the gastown command namespace"
-    ! grep -Fq 'GC_PACK_DIR' "$FORMULA" ||
-        fail "agent formulas must not assume managed sessions receive GC_PACK_DIR"
+    # Scoped to the step that runs the heartbeat check. The formula's
+    # dolt-push-divergence step legitimately keeps GC_PACK_DIR as a fallback
+    # behind the formula-source lookup (gcp-oo0v); the rule this pins is that
+    # the heartbeat dispatch never depends on it.
+    python3 - "$FORMULA" <<'PY' ||
+import sys
+import tomllib
+
+with open(sys.argv[1], "rb") as handle:
+    formula = tomllib.load(handle)
+steps = [s for s in formula["steps"] if "witness-heartbeat-check" in s.get("description", "")]
+if not steps:
+    raise SystemExit("no step runs witness-heartbeat-check")
+for step in steps:
+    if "GC_PACK_DIR" in step["description"]:
+        raise SystemExit(f"step {step['id']} depends on GC_PACK_DIR")
+PY
+        fail "the heartbeat step must not assume managed sessions receive GC_PACK_DIR"
     [ -x "$COMMAND" ] ||
         fail "the witness-heartbeat-check pack command must be executable"
 
