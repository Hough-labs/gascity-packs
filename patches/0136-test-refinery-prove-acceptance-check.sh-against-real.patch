+case_record_message_and_note_caps() {
+    new_case record-message-and-note-caps
+    record_rig
+    local tail=' - note on gcp-r1 (refinery, warn: merging)' i
+
+    printf '%s\n' 'AC1 OK — a | f:1' 'AC2 MISSING — b | absent' 'AC3 SUBSTITUTED — c | f:3' 'AC4 DECLARED — d | f:4' >"$T/stdin"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "MISS names the missing and substituted items" \
+        "ACCEPTANCE MISS: gcp-r1 AC2,AC3$tail" "$(nudge_message 1)"
+    reset_record
+    printf '%s\n' 'AC1 OK — a | f:1' 'AC2 MISSING — b | absent' 'AC3 SUBSTITUTED — c | f:3' 'AC4 DECLARED — d | f:4' >"$T/stdin"
+    run_ac record --work gcp-r1 --verdict DECLARED --tip "$X"
+    assert_eq "DECLARED names the declared item" \
+        "ACCEPTANCE DECLARED: gcp-r1 AC4$tail" "$(nudge_message 1)"
+
+    reset_record
+    printf '%s\n' 'AC1 OK — a | f:1' >"$T/stdin"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "no line with a matching second field" \
+        "ACCEPTANCE MISS: gcp-r1 see note$tail" "$(nudge_message 1)"
+
+    reset_record
+    for i in $(seq 1 40); do printf 'AC%s SUBSTITUTED — item %s | f:%s\n' "$i" "$i" "$i"; done >"$T/stdin"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    local message
+    message=$(nudge_message 1)
+    [ "${#message}" -le 200 ] || fail "the message is ${#message} characters, want at most 200"
+    case "$message" in
+        *"$tail") ;;
+        *) fail "the message lost its note pointer: $message" ;;
+    esac
+    assert_match "the id list is what got cut" '^ACCEPTANCE MISS: gcp-r1 AC1,AC2,' "$message"
+
+    reset_record
+    for i in $(seq 1 60); do printf 'AC%s SUBSTITUTED — item %s | f:%s\n' "$i" "$i" "$i"; done >"$T/stdin"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "the note holds exactly 40 stdin lines" 40 "$(grep -c '^AC[0-9]* SUBSTITUTED' "$BEADS/gcp-r1.notelog")"
+    grep -q '^AC40 ' "$BEADS/gcp-r1.notelog" || fail "the note lacks the fortieth line"
+    grep -q '^AC41 ' "$BEADS/gcp-r1.notelog" && fail "the note holds a line past the fortieth"
+    [ "$(wc -c <"$BEADS/gcp-r1.notelog" | tr -d ' ')" -le 4000 ] || fail "the note is longer than 4000 characters"
+    end_case
+}
