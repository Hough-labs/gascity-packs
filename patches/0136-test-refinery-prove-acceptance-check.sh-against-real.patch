+# The notes field is five lines, then filler, then a last line, 5000 characters in
+# all: the declaration on line 5 is far outside the 2000-character tail.
+case_packet_notes() {
+    new_case packet-notes
+    packet_rig gcp-o1 "1. A case in app/o.test.ts." app/o.test.ts "it('o', () => {})"
+    local first5 last pad notes
+    first5=$'first filler line\nsecond filler line\nUNRELATED EARLY LINE\nfourth filler line\nAC3 DEVIATION: the footnote case is not written, because the screen has no footnotes\n'
+    last="LAST LINE MARKER"
+    pad=$((5000 - ${#first5} - ${#last} - 1))
+    notes="$first5$(printf '%*s' "$pad" '' | tr ' ' x)"$'\n'"$last"
+    assert_eq "harness: the notes are 5000 characters" 5000 "${#notes}"
+    set_field gcp-o1 notes "$notes"
+
+    run_ac packet --work gcp-o1
+    assert_eq "packet exits 0" 0 "$RC"
+    assert_eq "the departure section holds the declared line, with its line number" \
+        "5:AC3 DEVIATION: the footnote case is not written, because the screen has no footnotes" \
+        "$(section 'NOTE LINES THAT MAY DECLARE A DEPARTURE')"
+    section_grep 'NOTE LINES THAT MAY DECLARE A DEPARTURE' -q 'UNRELATED EARLY LINE' &&
+        fail "the early unrelated line is in the departure section"
+    section_grep 'LATEST NOTES' -q 'UNRELATED EARLY LINE' &&
+        fail "the early unrelated line is in the latest-notes section"
+    assert_eq "the LATEST NOTES body is the last 2000 bytes of the notes" \
+        "$(printf '%s' "$notes" | tail -c 2000)" "$(section 'LATEST NOTES')"
+    assert_read_only "packet"
+
+    # Forty matching lines of 600 characters: the first 30, each cut to 400.
+    local i line want="" got
+    notes=""
+    for i in $(seq 1 40); do
+        line="departure $i "
+        line="$line$(printf '%*s' $((600 - ${#line})) '' | tr ' ' x)"
+        notes="$notes$line"$'\n'
+        if [ "$i" -le 30 ]; then want="$want$i:${line:0:400}"$'\n'; fi
+    done
+    set_field gcp-o1 notes "$notes"
+    run_ac packet --work gcp-o1
+    assert_eq "the second packet exits 0" 0 "$RC"
+    got=$(section 'NOTE LINES THAT MAY DECLARE A DEPARTURE')
+    assert_eq "the departure section holds the first 30 lines, each cut to 400 characters" "${want%$'\n'}" "$got"
+    assert_read_only "the second packet"
+    end_case
+}
