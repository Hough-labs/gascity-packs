+case_packet_cap() {
+    new_case packet-cap
+    init_rig
+    start_branch gcp-c1
+    mkdir -p "$POLECAT/tests"
+    awk 'BEGIN { for (i = 1; i <= 3000; i++) printf "%030d\n", i }' >"$POLECAT/tests/big_test.go"
+    put_file tests/small_test.go "package tests"
+    commit_all "test: big and small"
+    push_branch gcp-c1
+    sync_refinery
+    write_bead gcp-c1
+    set_field gcp-c1 acceptance_criteria "1. Go cases in tests/big_test.go and tests/small_test.go."
+    local x m full_lines body_chars body_lines cut n h
+    x=$(branch_tip gcp-c1)
+    m=$(git -C "$REFINERY" merge-base "refs/remotes/origin/$TARGET_NAME" "$x")
+    full_lines=$(git -C "$REFINERY" diff -U3 "$m" "$x" -- tests/big_test.go tests/small_test.go | wc -l | tr -d ' ')
+
+    run_ac packet --work gcp-c1
+    assert_eq "packet exits 0" 0 "$RC"
+    body_chars=$(hunk_body | wc -c | tr -d ' ')
+    body_lines=$(hunk_body | wc -l | tr -d ' ')
+    [ "$body_chars" -gt 17900 ] && [ "$body_chars" -le 18000 ] ||
+        fail "the hunk lines before the cut total $body_chars characters, want more than 17900 and at most 18000"
+    cut=$(section_grep 'TEST HUNKS' -E '^\[cut: ' || true)
+    assert_match "the cut line" '^\[cut: [0-9]+ more lines; headers follow\]$' "$cut"
+    n="${cut#\[cut: }"
+    n="${n%% *}"
+    assert_eq "N plus the printed hunk lines is the full diff's line count" "$full_lines" "$((n + body_lines))"
+    section 'TEST HUNKS' >"$T/hunks"
+    while IFS= read -r h; do
+        grep -Fxq -- "$h" "$T/hunks" || fail "the full diff's header line is missing from the section: $h"
+    done < <(git -C "$REFINERY" diff -U3 "$m" "$x" -- tests/big_test.go tests/small_test.go | grep -E '^(diff --git|@@)')
+    [ "$(wc -c <"$T/out" | tr -d ' ')" -lt 30000 ] || fail "the whole packet is not under 30000 characters"
+    assert_read_only "packet at the default cap"
+
+    run_ac packet --work gcp-c1 --cap-chars 500
+    assert_eq "packet --cap-chars 500 exits 0" 0 "$RC"
+    body_chars=$(hunk_body | wc -c | tr -d ' ')
+    [ "$body_chars" -le 500 ] || fail "--cap-chars 500: the hunk lines before the cut total $body_chars characters"
+    section_grep 'TEST HUNKS' -Eq '^\[cut: ' || fail "--cap-chars 500 did not cut"
+    assert_read_only "packet --cap-chars 500"
+    end_case
+}
