+        assert_eq "$verdict: acceptance_check_mode" warn "$(bead_meta gcp-r1 acceptance_check_mode)"
+        assert_eq "$verdict: no acceptance_check_nudge key" "<unset>" "$(bead_meta gcp-r1 acceptance_check_nudge)"
+        assert_eq "$verdict: no note call" 0 "$(calls '^gc bd note ')"
+        assert_eq "$verdict: no label call" 0 "$(calls '--add-label')"
+        assert_eq "$verdict: no nudge call" 0 "$(calls '^gc session nudge ')"
+        assert_eq "$verdict: the last stdout line" "acceptance-check: RESULT 0 gcp-r1 $verdict nudge=none" "$(last_line)"
+    done
+    end_case
+}
