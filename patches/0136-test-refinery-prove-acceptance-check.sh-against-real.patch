+case_record_conforms_and_skip() {
+    new_case record-conforms-and-skip
+    record_rig
+    local verdict
+    for verdict in CONFORMS SKIP; do
+        reset_record
+        run_ac record --work gcp-r1 --verdict "$verdict" --tip "$X"
