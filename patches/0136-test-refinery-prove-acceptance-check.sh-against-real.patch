From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Mon, 5 Oct 2026 22:08:33 -0400
Subject: [PATCH 136/140] test(refinery): prove acceptance-check.sh against
 real git (gcp-s7j4.1)

acceptance-check.sh is inert until gcp-s7j4.2, so this suite is its whole
proof. It is modeled on test_refinery_merge_batch.sh: a bare origin, a polecat
clone that pushes one branch per bead, the refinery's clone after
`git fetch --prune origin`, a gc stub over a directory of bead files that
journals every call and exits 64 on any call it does not model, every script run
under env -i, and EXPECTED_CASES so the suite fails unless all 19 cases ran.

The cases are the bead's acceptance items 1 to 19, named as the bead names them.
Every case that runs packet also asserts the gc log has no update, note, close or
nudge call. All fixture text is synthetic: this repository is public.

Validation: the suite passes, and it fails against copies of the script with one
defect each (no suffix boundary, a diff from the target tip, the wrong label, no
hunk cap, no message cut, a short notes tail, a skipped already-judged check, a
note cap of 400 lines, a nudge to this agent, a write chain that continues past a
failed note, and a wrong RESULT default).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../tests/test_refinery_acceptance_check.sh   | 1067 +++++++++++++++++
 1 file changed, 1067 insertions(+)
 create mode 100755 gastown/tests/test_refinery_acceptance_check.sh

diff --git a/gastown/tests/test_refinery_acceptance_check.sh b/gastown/tests/test_refinery_acceptance_check.sh
new file mode 100755
index 00000000..52a1bff4
--- /dev/null
+++ b/gastown/tests/test_refinery_acceptance_check.sh
@@ -0,0 +1,1067 @@
+#!/usr/bin/env bash
+# Black-box proof of acceptance-check.sh `packet` and `record` against real git
+# repositories (gcp-s7j4.1).
+#
+# acceptance-check.sh is the mechanics of the refinery's acceptance read: `packet`
+# builds what the reader reads, `record` writes down the verdict the reader
+# reached. It is inert until the formula calls it (gcp-s7j4.2), so these cases are
+# its whole proof: each one asserts what the script PRINTED and what it WROTE,
+# never how it is written, except case_text_invariants, whose subject is the
+# script's text.
+#
+# The rig is real git: a bare origin, a polecat clone that pushes one branch per
+# bead, and the refinery's clone after `git fetch --prune origin`. Only gc is
+# stubbed. The stub is modeled on test_refinery_merge_batch.sh's, over a fixture
+# DIRECTORY with one JSON file per bead:
+#   gc bd show <id> --json    that bead's file; fails for the ids in GC_STUB_FAIL_SHOW
+#   gc bd update <id> ...     --set-metadata k=v and --add-label <label>; fails for
+#                             the ids in GC_STUB_FAIL_UPDATE, and, for a call that
+#                             adds a label, for the ids in GC_STUB_FAIL_LABEL
+#   gc bd note <id> --stdin   appends the note to $GC_STUB_BEADS/<id>.notelog;
+#                             fails for the ids in GC_STUB_FAIL_NOTE
+#   gc session nudge <target> <message>
+#                             journals "<target><TAB><message>" to $GC_STUB_NUDGES,
+#                             failed attempts too; fails for the targets in
+#                             GC_STUB_FAIL_NUDGE
+# Every call is journalled to $T/gc.log. A call the model does not know fails
+# loudly (exit 64) and fails the case.
+#
+# Each script run is under `env -i`, so no agent-session GC_* variable can leak
+# in. SCRIPT may point at another copy of acceptance-check.sh; it finds
+# merge-push.sh beside itself, so stage a copy as a pack tree.
+#
+# ALL fixture text is synthetic: this repository is public. The cases reproduce
+# the SHAPES the design measured (three named test files with one changed, a hunk
+# that fails the second of two calls where the criteria fail the first, a value
+# of 47 where the criteria say 0, a keep-passing file named but unchanged), with
+# invented paths and wording.
+#
+# The suite fails unless all 19 cases ran.
+set -uo pipefail
+
+ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+PACK_DIR="$ROOT/gastown"
+SCRIPT="${SCRIPT:-$PACK_DIR/assets/scripts/refinery/acceptance-check.sh}"
+EXPECTED_CASES=19
+
+AGENT=testrig/gastown.refinery
+TARGET_NAME=integration
+FAILURES=0
+PASS_CASES=0
+CASE=""
+
+fail() {
+    echo "FAIL[$CASE]: $*" >&2
+    FAILURES=$((FAILURES + 1))
+}
+
+assert_eq() {
+    # assert_eq <what> <want> <got>
+    [ "$2" = "$3" ] || fail "$1: want '$2', got '$3'"
+}
+
+# assert_match <what> <extended regex> <got>
+assert_match() {
+    grep -Eq -- "$2" <<<"$3" || fail "$1: '$3' does not match /$2/"
+}
+
+# --- stubs ------------------------------------------------------------------
+
+write_gc_stub() {
+    cat >"$1/gc" <<'STUB'
+#!/usr/bin/env bash
+ARGS=("$@")
+printf 'gc %s\n' "$*" >>"$GC_STUB_LOG"
+unexpected() {
+    printf 'gc %s\n' "${ARGS[*]}" >>"$STUB_UNEXPECTED"
+    echo "stub gc: unexpected invocation: gc ${ARGS[*]}" >&2
+    exit 64
+}
+edit_bead() {
+    local file="$1" tmp
+    shift
+    tmp=$(mktemp) || exit 70
+    jq "$@" "$file" >"$tmp" && mv -f "$tmp" "$file"
+}
+case "${1:-}" in
+bd)
+    case "${2:-}" in
+    show)
+        { [ "$#" -eq 4 ] && [ "$4" = --json ]; } || unexpected
+        case " ${GC_STUB_FAIL_SHOW:-} " in
+        *" $3 "*)
+            echo "stub gc: gc bd show $3 failed on request" >&2
+            exit 1
+            ;;
+        esac
+        [ -f "$GC_STUB_BEADS/$3.json" ] || {
+            echo "stub gc: no such bead: $3" >&2
+            exit 1
+        }
+        cat "$GC_STUB_BEADS/$3.json"
+        ;;
+    update)
+        id="${3:-}"
+        file="$GC_STUB_BEADS/$id.json"
+        [ -f "$file" ] || unexpected
+        case " ${GC_STUB_FAIL_UPDATE:-} " in
+        *" $id "*)
+            echo "stub gc: gc bd update $id failed on request" >&2
+            exit 1
+            ;;
+        esac
+        case " ${ARGS[*]} " in
+        *" --add-label"*)
+            case " ${GC_STUB_FAIL_LABEL:-} " in
+            *" $id "*)
+                echo "stub gc: gc bd update $id --add-label failed on request" >&2
+                exit 1
+                ;;
+            esac
+            ;;
+        esac
+        shift 3
+        while [ "$#" -gt 0 ]; do
+            case "$1" in
+            --set-metadata)
+                edit_bead "$file" --arg k "${2%%=*}" --arg v "${2#*=}" '.[0].metadata[$k] = $v'
+                shift
+                ;;
+            --add-label)
+                edit_bead "$file" --arg v "$2" '.[0].labels = (((.[0].labels // []) + [$v]) | unique)'
+                shift
+                ;;
+            *) unexpected ;;
+            esac
+            shift
+        done
+        ;;
+    note)
+        # gc bd note <id> --stdin: the note text is appended to <id>.notelog.
+        { [ "$#" -eq 4 ] && [ "$4" = --stdin ] && [ -f "$GC_STUB_BEADS/${3:-}.json" ]; } || unexpected
+        case " ${GC_STUB_FAIL_NOTE:-} " in
+        *" $3 "*)
+            echo "stub gc: gc bd note $3 failed on request" >&2
+            exit 1
+            ;;
+        esac
+        cat >>"$GC_STUB_BEADS/$3.notelog"
+        ;;
+    *) unexpected ;;
+    esac
+    ;;
+session)
+    { [ "${2:-}" = nudge ] && [ "$#" -eq 4 ]; } || unexpected
+    printf '%s\t%s\n' "$3" "$4" >>"$GC_STUB_NUDGES"
+    case " ${GC_STUB_FAIL_NUDGE:-} " in
+    *" $3 "*)
+        echo "stub gc: gc session nudge $3 failed on request" >&2
+        exit 1
+        ;;
+    esac
+    ;;
+*) unexpected ;;
+esac
+exit 0
+STUB
+    chmod +x "$1/gc"
+}
+
+# --- rig --------------------------------------------------------------------
+
+git_q() { git "$@" >/dev/null 2>&1; }
+
+new_case() {
+    CASE="$1"
+    CASE_START_FAILURES=$FAILURES
+    T=$(mktemp -d "${TMPDIR:-/tmp}/acceptance-check.XXXXXX")
+    ORIGIN="$T/origin.git"
+    SEED="$T/seed"
+    POLECAT="$T/polecat"
+    REFINERY="$T/refinery"
+    BEADS="$T/beads"
+    mkdir -p "$T/home" "$T/tmp" "$T/bin" "$BEADS"
+    cat >"$T/home/.gitconfig" <<'CFG'
+[init]
+	defaultBranch = integration
+[user]
+	name = refinery
+	email = refinery@example.invalid
+[advice]
+	detachedHead = false
+[protocol "file"]
+	allow = always
+[commit]
+	gpgsign = false
+CFG
+    export HOME="$T/home"
+    export GIT_CONFIG_GLOBAL="$T/home/.gitconfig"
+    export GIT_CONFIG_NOSYSTEM=1
+    export GIT_AUTHOR_NAME=refinery GIT_AUTHOR_EMAIL=refinery@example.invalid
+    export GIT_COMMITTER_NAME=refinery GIT_COMMITTER_EMAIL=refinery@example.invalid
+    write_gc_stub "$T/bin"
+    : >"$T/gc.log"
+    : >"$T/unexpected"
+    : >"$T/out"
+    : >"$T/err"
+    : >"$T/stdin"
+    : >"$T/nudges"
+    FAIL_SHOW=""
+    FAIL_UPDATE=""
+    FAIL_LABEL=""
+    FAIL_NOTE=""
+    FAIL_NUDGE=""
+    EXTRA_ENV=()
+    CONFIG_DEFAULT_BRANCH="$TARGET_NAME"
+    CONFIG_JSON="$T/config.json"
+    write_config
+}
+
+end_case() {
+    [ ! -s "$T/unexpected" ] || fail "unmodelled stub call(s): $(tr '\n' ';' <"$T/unexpected")"
+    if [ "$FAILURES" -ne "$CASE_START_FAILURES" ]; then
+        {
+            echo "--- $CASE: last run (status $(cat "$T/rc" 2>/dev/null)) stdout ---"
+            cat "$T/out"
+            echo "--- $CASE: last run stderr ---"
+            cat "$T/err"
+            echo "--- $CASE: gc calls ---"
+            cat "$T/gc.log"
+        } >&2
+    fi
+    trash "$T" 2>/dev/null || rm -rf "$T"
+    PASS_CASES=$((PASS_CASES + 1))
+}
+
+# write_config — the city config the script reads through MERGE_PUSH_CONFIG_JSON.
+write_config() {
+    jq -n --arg d "$CONFIG_DEFAULT_BRANCH" \
+        '{config: {Rigs: [{Name: "testrig", DefaultBranch: $d, FormulaVars: {}}]}}' >"$CONFIG_JSON"
+}
+
+# init_rig — a bare origin holding the baseline, and the clone polecats work in.
+init_rig() {
+    git_q init --bare "$ORIGIN"
+    git_q init "$SEED"
+    echo baseline >"$SEED/README.md"
+    git_q -C "$SEED" add -A
+    git_q -C "$SEED" commit -m "chore: baseline"
+    git_q -C "$SEED" remote add origin "$ORIGIN"
+    git_q -C "$SEED" push origin HEAD:integration
+    FORK_SHA=$(git -C "$SEED" rev-parse HEAD)
+    git_q clone "$ORIGIN" "$POLECAT"
+}
+
+# start_branch <bead-id> — polecat/<bead-id> forks from the baseline.
+start_branch() { git_q -C "$POLECAT" checkout -B "polecat/$1" "$FORK_SHA"; }
+
+# put_file <path> <content> — write one file in the polecat clone.
+put_file() {
+    mkdir -p "$(dirname "$POLECAT/$1")"
+    printf '%s\n' "$2" >"$POLECAT/$1"
+}
+
+commit_all() {
+    git_q -C "$POLECAT" add -A
+    git_q -C "$POLECAT" commit -m "$1"
+}
+
+push_branch() { git_q -C "$POLECAT" push -f origin "polecat/$1"; }
+
+# sync_refinery — the refinery's clone, then the fetch the patrol runs once before
+# it reads any packet.
+sync_refinery() {
+    [ -d "$REFINERY" ] || git_q clone "$ORIGIN" "$REFINERY"
+    git_q -C "$REFINERY" fetch --prune origin
+}
+
+# move_target <file> — another bead's work lands on the target after the fork.
+move_target() {
+    git_q -C "$SEED" pull origin integration
+    echo "someone else" >"$SEED/$1"
+    git_q -C "$SEED" add "$1"
+    git_q -C "$SEED" commit -m "feat: a concurrent bead"
+    git_q -C "$SEED" push origin HEAD:integration
+}
+
+branch_tip() { git -C "$REFINERY" rev-parse --verify "refs/remotes/origin/polecat/$1"; }
+
+# --- beads ------------------------------------------------------------------
+
+# write_bead <id> [key=value ...] — a bead as `gc bd show` returns it, assigned to
+# the refinery, with the polecat's branch metadata and empty criteria and notes.
+write_bead() {
+    local id="$1" kv
+    shift
+    jq -n --arg id "$id" --arg agent "$AGENT" --arg branch "polecat/$id" --arg target "$TARGET_NAME" \
+        '[{id: $id, title: ("Bead " + $id), status: "in_progress", assignee: $agent,
+           issue_type: "task", acceptance_criteria: "", notes: "",
+           metadata: {branch: $branch, target: $target}}]' >"$BEADS/$id.json"
+    for kv in "$@"; do
+        set_meta "$id" "${kv%%=*}" "${kv#*=}"
+    done
+}
+
+set_meta() {
+    local tmp
+    tmp=$(mktemp)
+    jq --arg k "$2" --arg v "$3" '.[0].metadata[$k] = $v' "$BEADS/$1.json" >"$tmp" && mv -f "$tmp" "$BEADS/$1.json"
+}
+
+unset_meta() {
+    local tmp
+    tmp=$(mktemp)
+    jq --arg k "$2" 'del(.[0].metadata[$k])' "$BEADS/$1.json" >"$tmp" && mv -f "$tmp" "$BEADS/$1.json"
+}
+
+# set_field <id> <top-level key> <value>
+set_field() {
+    local tmp
+    tmp=$(mktemp)
+    jq --arg k "$2" --arg v "$3" '.[0][$k] = $v' "$BEADS/$1.json" >"$tmp" && mv -f "$tmp" "$BEADS/$1.json"
+}
+
+bead_meta() { jq -r --arg k "$2" '.[0].metadata[$k] // "<unset>"' "$BEADS/$1.json"; }
+bead_field() { jq -r --arg k "$2" '.[0][$k] // "<unset>"' "$BEADS/$1.json"; }
+bead_sum() { cksum <"$BEADS/$1.json"; }
+bead_has_label() { jq -e --arg l "$2" '(.[0].labels // []) | index($l) != null' "$BEADS/$1.json" >/dev/null 2>&1; }
+
+# --- running the script -----------------------------------------------------
+
+# run_ac <args...> — run acceptance-check.sh inside the refinery clone, as the
+# patrol does, with $T/stdin as its stdin. Sets RC, and leaves stdout in $T/out and
+# stderr in $T/err. The cd fails closed: a script run anywhere else would read the
+# refs of whatever checkout the suite started in.
+run_ac() {
+    (
+        cd "$REFINERY" || exit 90
+        env -i \
+            PATH="$T/bin:$PATH" HOME="$T/home" TMPDIR="$T/tmp" \
+            GIT_CONFIG_GLOBAL="$T/home/.gitconfig" GIT_CONFIG_NOSYSTEM=1 \
+            GIT_AUTHOR_NAME=refinery GIT_AUTHOR_EMAIL=refinery@example.invalid \
+            GIT_COMMITTER_NAME=refinery GIT_COMMITTER_EMAIL=refinery@example.invalid \
+            GC_RIG=testrig GC_AGENT="$AGENT" MERGE_PUSH_CONFIG_JSON="$CONFIG_JSON" \
+            GC_STUB_LOG="$T/gc.log" GC_STUB_BEADS="$BEADS" GC_STUB_NUDGES="$T/nudges" \
+            GC_STUB_FAIL_SHOW="$FAIL_SHOW" GC_STUB_FAIL_UPDATE="$FAIL_UPDATE" \
+            GC_STUB_FAIL_LABEL="$FAIL_LABEL" GC_STUB_FAIL_NOTE="$FAIL_NOTE" \
+            GC_STUB_FAIL_NUDGE="$FAIL_NUDGE" STUB_UNEXPECTED="$T/unexpected" \
+            ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} \
+            "$BASH" "$SCRIPT" "$@" <"$T/stdin"
+    ) >"$T/out" 2>"$T/err"
+    RC=$?
+    echo "$RC" >"$T/rc"
+}
+
+last_line() { tail -n 1 "$T/out"; }
+
+# calls <extended regex> — how many journalled gc calls match.
+calls() { grep -cE -- "$1" "$T/gc.log"; }
+
+# assert_read_only <what> — packet never writes: no update, note, close or nudge.
+assert_read_only() {
+    assert_eq "$1: the gc log has no write call" 0 "$(calls '^gc (bd (update|note|close) |session nudge )')"
+}
+
+# section <header prefix> — the body of one packet section: the lines after
+# "== <prefix>..." up to the next "== " header.
+section() {
+    awk -v h="== $1" 'index($0, h) == 1 { on = 1; next } /^== / { on = 0 } on' "$T/out"
+}
+
+# section_grep <header prefix> <grep args...> — grep one packet section. The
+# section goes to a file first: `grep -q` quits at its first match, and with
+# pipefail on, a producer that takes SIGPIPE would fail the pipeline spuriously.
+section_grep() {
+    local header="$1"
+    shift
+    section "$header" >"$T/section"
+    grep "$@" "$T/section"
+}
+
+# hunk_body — the TEST HUNKS lines printed before the cut line.
+hunk_body() { section 'TEST HUNKS' | awk '/^\[cut: / { exit } { print }'; }
+
+# --- cases: packet ----------------------------------------------------------
+
+# One packet run against a one-branch rig. packet_rig <bead-id> <AC> <path> <content>...
+# adds each <path>/<content> pair to the branch, in one commit.
+packet_rig() {
+    local id="$1" ac="$2"
+    shift 2
+    init_rig
+    start_branch "$id"
+    while [ "$#" -ge 2 ]; do
+        put_file "$1" "$2"
+        shift 2
+    done
+    commit_all "feat: $id"
+    push_branch "$id"
+    sync_refinery
+    write_bead "$id"
+    set_field "$id" acceptance_criteria "$ac"
+}
+
+# assert_no_verdict <what> — packet never prints a verdict.
+assert_no_verdict() {
+    grep -Eq 'CONFORMS|DECLARED|MISS' "$T/out" && fail "$1: a stdout line carries a verdict word"
+    return 0
+}
+
+case_packet_missing_named_files() {
+    new_case packet-missing-named-files
+    packet_rig gcp-n1 "1. Jest in app/features/alpha/alpha-list.test.tsx: a case. The same case in features/beta/beta-screen.test.tsx and features/gamma/gamma-screen.test.tsx." \
+        app/features/alpha/alpha-list.test.tsx "it('lists the alpha rows', () => {})" \
+        app/features/alpha/alpha.ts "export const alpha = 1"
+    run_ac packet --work gcp-n1
+    assert_eq "packet exits 0" 0 "$RC"
+    assert_eq "NAMED TEST FILES, sorted by the named path" \
+        "IN-DIFF app/features/alpha/alpha-list.test.tsx (app/features/alpha/alpha-list.test.tsx)
+NOT-IN-DIFF features/beta/beta-screen.test.tsx
+NOT-IN-DIFF features/gamma/gamma-screen.test.tsx" \
+        "$(section 'NAMED TEST FILES')"
+    assert_read_only "packet"
+    end_case
+}
+
+case_packet_setup_substitution() {
+    new_case packet-setup-substitution
+    local ac='2. Jest in app/lib/lib-screen.test.tsx: two concurrent saves, first held; failing the FIRST names that row.'
+    local hunk_line='    saveSpy.mockImplementationOnce(held).mockRejectedValueOnce(boom)'
+    packet_rig gcp-s1 "$ac" \
+        app/lib/lib-screen.test.tsx "describe('lib screen', () => {
+  it('names the row whose save failed', async () => {
+    const held = new Promise(() => {})
+    const boom = new Error('boom')
+$hunk_line
+  })
+})"
+    run_ac packet --work gcp-s1
+    assert_eq "packet exits 0" 0 "$RC"
+    section_grep 'ACCEPTANCE' -Fxq -- "$ac" || fail "the ACCEPTANCE section does not hold the AC line byte for byte"
+    section_grep 'TEST HUNKS' -Fxq -- "+$hunk_line" || fail "the TEST HUNKS section does not hold the setup line prefixed with +"
+    assert_no_verdict "packet"
+    assert_read_only "packet"
+    end_case
+}
+
+case_packet_value_substitution() {
+    new_case packet-value-substitution
+    packet_rig gcp-v1 "2. app/nav/bar.test.tsx: the first height published at inset 0 is 45." \
+        app/nav/bar.test.tsx "const METRICS = { inset: 47 }
+it('publishes the first height', () => {
+expect(published).toEqual([92])
+})"
+    run_ac packet --work gcp-v1
+    assert_eq "packet exits 0" 0 "$RC"
+    section_grep 'TEST HUNKS' -Fxq -- '+const METRICS = { inset: 47 }' || fail "TEST HUNKS lacks the metrics line prefixed with +"
+    section_grep 'TEST HUNKS' -Fxq -- '+expect(published).toEqual([92])' || fail "TEST HUNKS lacks the assertion line prefixed with +"
+    assert_read_only "packet"
+    end_case
+}
+
+case_packet_keep_passing_file() {
+    new_case packet-keep-passing-file
+    packet_rig gcp-k1 "5. NO REGRESSION: bats tests/one.bats tests/two.bats exits 0." \
+        tests/three.bats "@test 'three' { true; }"
+    run_ac packet --work gcp-k1
+    assert_eq "packet exits 0, not a skip" 0 "$RC"
+    assert_match "the first line is the PACKET line" '^acceptance-check: PACKET gcp-k1 ' "$(head -n 1 "$T/out")"
+    assert_eq "NAMED TEST FILES" \
+        "NOT-IN-DIFF tests/one.bats
+NOT-IN-DIFF tests/two.bats" \
+        "$(section 'NAMED TEST FILES')"
+    assert_no_verdict "packet"
+    assert_read_only "packet"
+    end_case
+}
+
+case_packet_suffix_boundary() {
+    new_case packet-suffix-boundary
+    # The backticks are the AC's own markdown, not a command substitution.
+    # shellcheck disable=SC2016
+    packet_rig gcp-b1 'The AC names `features/x/widget.test.ts` and `gadget.test.ts`.' \
+        src/features/x/widget.test.ts "it('widget', () => {})" \
+        src/supergadget.test.ts "it('supergadget', () => {})"
+    run_ac packet --work gcp-b1
+    assert_eq "packet exits 0" 0 "$RC"
+    assert_eq "a named path matches on a whole trailing path, never a partial name" \
+        "IN-DIFF features/x/widget.test.ts (src/features/x/widget.test.ts)
+NOT-IN-DIFF gadget.test.ts" \
+        "$(section 'NAMED TEST FILES')"
+    assert_read_only "packet"
+    end_case
+}
+
+case_packet_pattern_table() {
+    new_case packet-pattern-table
+    local paths="a/one_test.go a/two.test.jsx a/three.spec.ts a/four.bats a/five_test.py a/test_six.py a/seven_test.sh a/test_eight.sh"
+    local p ac="The AC names" args=()
+    for p in $paths; do
+        ac="$ac $p,"
+        args+=("$p" "content of $p")
+    done
+    packet_rig gcp-t1 "$ac" "${args[@]}" src/app.ts "export const app = 1"
+    run_ac packet --work gcp-t1
+    assert_eq "packet exits 0" 0 "$RC"
+    for p in $paths; do
+        section_grep 'NAMED TEST FILES' -Fxq -- "IN-DIFF $p ($p)" || fail "no IN-DIFF line for $p"
+        section_grep 'TEST HUNKS' -Fxq -- "diff --git a/$p b/$p" || fail "no diff --git header for $p"
+    done
+    assert_eq "TEST HUNKS holds no header for src/app.ts" 0 "$(section_grep 'TEST HUNKS' -c 'src/app.ts')"
