+case_record_notify_fallback() {
+    new_case record-notify-fallback
+    record_rig
+    # fresh_parent <slung_by|-> <parent assignee|->: the bead, and its parent bead.
+    fresh_parent() {
+        reset_record
+        FAIL_NUDGE=""
+        write_bead gcp-rp
+        if [ "$2" = - ]; then
+            jq 'del(.[0].assignee)' "$BEADS/gcp-rp.json" >"$T/rp.json" && mv -f "$T/rp.json" "$BEADS/gcp-rp.json"
+        else
+            set_field gcp-rp assignee "$2"
+        fi
+        set_field gcp-r1 parent gcp-rp
+        if [ "$1" = - ]; then unset_meta gcp-r1 slung_by; else set_meta gcp-r1 slung_by "$1"; fi
+        printf '%s\n' "$ITEM_MISS" >"$T/stdin"
+    }
+
+    fresh_parent - testrig/crew.other
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "no slung_by: exit status" 0 "$RC"
+    assert_eq "no slung_by: one nudge" 1 "$(nudge_count)"
+    assert_eq "no slung_by: it goes to the parent's assignee" testrig/crew.other "$(nudge_target 1)"
+    assert_eq "the parent is read through gc bd show" 1 "$(calls '^gc bd show gcp-rp --json$')"
+
+    fresh_parent testrig/crew.seat -
+    FAIL_NUDGE="testrig/crew.seat"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "a failed nudge, no parent assignee: exit status" 0 "$RC"
+    assert_eq "the nudges tried" "testrig/crew.seat
+mayor" "$(cut -f1 "$T/nudges")"
+    assert_eq "the outcome" "delivered: mayor" "$(bead_meta gcp-r1 acceptance_check_nudge)"
+    assert_eq "the RESULT line" "acceptance-check: RESULT 0 gcp-r1 MISS nudge=mayor" "$(last_line)"
+
+    fresh_parent testrig/crew.seat testrig/crew.other
+    FAIL_NUDGE="testrig/crew.seat testrig/crew.other mayor"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "every nudge failed: exit status" 0 "$RC"
+    assert_eq "every nudge failed: the outcome" "failed: testrig/crew.seat testrig/crew.other mayor" \
+        "$(bead_meta gcp-r1 acceptance_check_nudge)"
+    assert_eq "every nudge failed: the RESULT line" "acceptance-check: RESULT 0 gcp-r1 MISS nudge=failed" "$(last_line)"
+
+    # slung_by is bead data: a value that reads as a flag is never handed to gc.
+    fresh_parent --force testrig/crew.other
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "a flag-like slung_by: exit status" 0 "$RC"
+    assert_eq "a flag-like slung_by is skipped, the next target is tried" testrig/crew.other \
+        "$(cut -f1 "$T/nudges")"
+    assert_eq "a flag-like slung_by: one attempt" 1 "$(nudge_count)"
+
+    fresh_parent "$AGENT" testrig/crew.other
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "slung_by is this agent: exit status" 0 "$RC"
+    assert_eq "slung_by is this agent: it is never tried, the next target is" testrig/crew.other \
+        "$(cut -f1 "$T/nudges")"
+    assert_eq "slung_by is this agent: one attempt" 1 "$(nudge_count)"
+    end_case
+}
+
+case_record_usage() {
+    new_case record-usage
+    record_rig
+    # expect_usage <what> <args...>
+    expect_usage() {
+        local what="$1"
+        shift
+        : >"$T/gc.log"
+        run_ac record "$@"
+        assert_eq "$what: exit status" 1 "$RC"
+        grep -q '^usage: acceptance-check.sh' "$T/err" || fail "$what: no stderr line starts 'usage: acceptance-check.sh'"
+        assert_eq "$what: no bead or nudge call" 0 "$(calls '^gc (bd (update|note) |session nudge )')"
+        assert_eq "$what: the last stdout line" "acceptance-check: RESULT 1 - - nudge=none" "$(last_line)"
+    }
+    expect_usage "a verdict outside the four" --work gcp-r1 --verdict MAYBE --tip "$X"
+    expect_usage "a missing --work" --verdict MISS --tip "$X"
+    expect_usage "a missing --tip" --work gcp-r1 --verdict MISS
+    expect_usage "--mode reject" --work gcp-r1 --verdict MISS --tip "$X" --mode reject
+    end_case
+}
+
+case_record_write_failure() {
+    new_case record-write-failure
+    record_rig
+    printf '%s\n' "$ITEM_MISS" >"$T/stdin"
+
+    FAIL_UPDATE=gcp-r1
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "a failed metadata write: exit status" 2 "$RC"
+    assert_eq "a failed metadata write: no note call" 0 "$(calls '^gc bd note ')"
+    assert_eq "a failed metadata write: no label call" 0 "$(calls '--add-label')"
+    assert_eq "a failed metadata write: no nudge" 0 "$(calls '^gc session nudge ')"
+    assert_eq "a failed metadata write: the last stdout line" \
+        "acceptance-check: RESULT 2 gcp-r1 MISS nudge=none" "$(last_line)"
+
+    reset_record
+    FAIL_UPDATE=""
+    FAIL_NOTE=gcp-r1
+    printf '%s\n' "$ITEM_MISS" >"$T/stdin"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "a failed note write: exit status" 2 "$RC"
+    assert_eq "a failed note write: acceptance_check" MISS "$(bead_meta gcp-r1 acceptance_check)"
+    assert_eq "a failed note write: acceptance_check_tip" "$X" "$(bead_meta gcp-r1 acceptance_check_tip)"
+    assert_eq "a failed note write: acceptance_check_mode" warn "$(bead_meta gcp-r1 acceptance_check_mode)"
+    assert_eq "a failed note write: no label call" 0 "$(calls '--add-label')"
+    assert_eq "a failed note write: no nudge" 0 "$(calls '^gc session nudge ')"
+    assert_eq "a failed note write: the last stdout line" \
+        "acceptance-check: RESULT 2 gcp-r1 MISS nudge=none" "$(last_line)"
+
+    reset_record
+    FAIL_NOTE=""
+    FAIL_LABEL=gcp-r1
+    printf '%s\n' "$ITEM_MISS" >"$T/stdin"
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "a failed label write: exit status" 2 "$RC"
+    assert_eq "a failed label write: acceptance_check" MISS "$(bead_meta gcp-r1 acceptance_check)"
+    assert_eq "a failed label write: the note was written" 1 "$(calls '^gc bd note gcp-r1 ')"
+    assert_eq "a failed label write: no nudge" 0 "$(calls '^gc session nudge ')"
+    assert_eq "a failed label write: the last stdout line" \
+        "acceptance-check: RESULT 2 gcp-r1 MISS nudge=none" "$(last_line)"
+    end_case
+}
