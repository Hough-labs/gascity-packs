+case_record_declared
+case_record_message_and_note_caps
+case_record_conforms_and_skip
+case_record_notify_fallback
+case_record_usage
+case_record_write_failure
+case_text_invariants
+
+if [ "$PASS_CASES" -ne "$EXPECTED_CASES" ]; then
+    echo "FAIL: $PASS_CASES of $EXPECTED_CASES cases ran" >&2
+    exit 1
+fi
+if [ "$FAILURES" -ne 0 ]; then
+    echo "FAIL: $FAILURES assertion(s) failed across $PASS_CASES cases" >&2
+    exit 1
+fi
+echo "OK: $PASS_CASES cases passed"
