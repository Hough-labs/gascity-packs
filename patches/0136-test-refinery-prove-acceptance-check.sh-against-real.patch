+# --- cases: record ----------------------------------------------------------
+
+# record_rig — a rig with one pushed branch and the bead gcp-r1, which a seat slung.
+# Sets X, the branch's full tip.
+record_rig() {
+    packet_rig gcp-r1 "1. A case in app/lib/lib-screen.test.tsx." app/lib/lib-screen.test.tsx "it('r', () => {})"
+    set_meta gcp-r1 slung_by testrig/crew.seat
+    X=$(branch_tip gcp-r1)
+}
+
+ITEM_MISS='AC2 SUBSTITUTED — fails the second | app/lib/lib-screen.test.tsx:12'
+
+# reset_record — clear what a record run wrote, so a case can run record again.
+reset_record() {
+    : >"$T/gc.log"
+    : >"$T/nudges"
+    : >"$T/stdin"
+    rm -f "$BEADS/gcp-r1.notelog"
+    write_bead gcp-r1 slung_by=testrig/crew.seat
+}
+
+nudge_count() { wc -l <"$T/nudges" | tr -d ' '; }
+nudge_target() { sed -n "${1}p" "$T/nudges" | cut -f1; }
+nudge_message() { sed -n "${1}p" "$T/nudges" | cut -f2; }
+note_first_line() { head -n 1 "$BEADS/$1.notelog"; }
+
+case_record_miss() {
+    new_case record-miss
+    record_rig
+    set_meta gcp-r1 gc.routed_to testrig/gastown.polecat
+    set_meta gcp-r1 rejection_reason "kept as is"
+    local untouched
+    untouched=$(jq -c '[.[0].status, .[0].assignee, .[0].metadata.rejection_reason, .[0].metadata["gc.routed_to"]]' "$BEADS/gcp-r1.json")
+    printf '%s\n' "$ITEM_MISS" >"$T/stdin"
+
+    run_ac record --work gcp-r1 --verdict MISS --tip "$X"
+    assert_eq "record exits 0" 0 "$RC"
+    assert_eq "acceptance_check" MISS "$(bead_meta gcp-r1 acceptance_check)"
+    assert_eq "acceptance_check_tip" "$X" "$(bead_meta gcp-r1 acceptance_check_tip)"
+    assert_eq "acceptance_check_mode" warn "$(bead_meta gcp-r1 acceptance_check_mode)"
+    assert_eq "acceptance_check_nudge" "delivered: testrig/crew.seat" "$(bead_meta gcp-r1 acceptance_check_nudge)"
+    assert_eq "exactly one note call" 1 "$(calls '^gc bd note gcp-r1 ')"
+    assert_match "the note's first line" \
+        "^\[acceptance-check warn [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z testrig/gastown\.refinery\] MISS at ${X:0:8}\$" \
+        "$(note_first_line gcp-r1)"
+    grep -Fxq -- "$ITEM_MISS" "$BEADS/gcp-r1.notelog" || fail "the note does not hold the stdin line"
+    grep -q '^Merged anyway (warn mode)\.' "$BEADS/gcp-r1.notelog" || fail "the note has no 'Merged anyway (warn mode).' line"
+    bead_has_label gcp-r1 acceptance-miss || fail "the bead lacks the label acceptance-miss"
+    assert_eq "exactly one nudge" 1 "$(nudge_count)"
+    assert_eq "the nudge goes to the seat" testrig/crew.seat "$(nudge_target 1)"
+    assert_eq "the nudge message" \
+        "ACCEPTANCE MISS: gcp-r1 AC2 - note on gcp-r1 (refinery, warn: merging)" "$(nudge_message 1)"
+    assert_eq "status, assignee, rejection and routing are untouched" "$untouched" \
+        "$(jq -c '[.[0].status, .[0].assignee, .[0].metadata.rejection_reason, .[0].metadata["gc.routed_to"]]' "$BEADS/gcp-r1.json")"
+    assert_eq "the last stdout line" "acceptance-check: RESULT 0 gcp-r1 MISS nudge=testrig/crew.seat" "$(last_line)"
+    end_case
+}
+
+case_record_declared() {
