+case_packet_skips() {
+    new_case packet-skips
+    init_rig
+    start_branch gcp-k1
+    put_file app/k.test.ts "it('first', () => {})"
+    commit_all "feat: first"
+    local older
+    older=$(git -C "$POLECAT" rev-parse HEAD)
+    put_file app/k2.test.ts "it('second', () => {})"
+    commit_all "feat: second"
+    push_branch gcp-k1
+    # gcp-k2 is the baseline itself: it adds nothing past the merge-base.
+    git_q -C "$POLECAT" push origin "$FORK_SHA:refs/heads/polecat/gcp-k2"
+    sync_refinery
+    local x x2
+    x=$(branch_tip gcp-k1)
+    x2=$(branch_tip gcp-k2)
+    reset_beads() {
+        write_bead gcp-k1
+        set_field gcp-k1 acceptance_criteria "1. A case in app/k.test.ts."
+        write_bead gcp-k2
+        set_field gcp-k2 acceptance_criteria "1. A case in app/k.test.ts."
+    }
+    # expect_skip <what> <bead> <line>
+    expect_skip() {
+        local before
+        before=$(bead_sum "$2")
+        : >"$T/gc.log"
+        run_ac packet --work "$2"
+        assert_eq "$1: exit status" 3 "$RC"
+        assert_eq "$1: stdout is the SKIP line" "$3" "$(cat "$T/out")"
+        assert_eq "$1: stdout is one line" 1 "$(wc -l <"$T/out" | tr -d ' ')"
+        assert_read_only "$1"
+        assert_eq "$1: the bead is unchanged" "$before" "$(bead_sum "$2")"
+    }
+
+    reset_beads
+    set_meta gcp-k1 branch ""
+    expect_skip "an empty metadata.branch" gcp-k1 "acceptance-check: SKIP gcp-k1 no-branch tip=none"
+
+    reset_beads
+    set_meta gcp-k1 branch polecat/never-pushed
+    expect_skip "a branch origin does not have" gcp-k1 "acceptance-check: SKIP gcp-k1 no-branch tip=none"
+
+    reset_beads
+    set_meta gcp-k1 target nosuch
+    expect_skip "a target origin does not have" gcp-k1 "acceptance-check: SKIP gcp-k1 no-branch tip=none"
+
+    reset_beads
+    set_field gcp-k1 acceptance_criteria ""
+    expect_skip "empty criteria" gcp-k1 "acceptance-check: SKIP gcp-k1 no-ac tip=$x"
+
+    reset_beads
+    expect_skip "a branch with no change past the merge-base" gcp-k2 "acceptance-check: SKIP gcp-k2 no-change tip=$x2"
+
+    reset_beads
+    set_meta gcp-k1 acceptance_check_tip "$x"
+    expect_skip "a branch already judged at its tip" gcp-k1 "acceptance-check: SKIP gcp-k1 already-judged tip=$x"
+
+    # The order the codes are checked in.
+    reset_beads
+    set_meta gcp-k1 branch ""
+    set_field gcp-k1 acceptance_criteria ""
+    expect_skip "an empty branch and empty criteria" gcp-k1 "acceptance-check: SKIP gcp-k1 no-branch tip=none"
+    reset_beads
+    set_field gcp-k2 acceptance_criteria ""
+    expect_skip "empty criteria and no change" gcp-k2 "acceptance-check: SKIP gcp-k2 no-ac tip=$x2"
+    reset_beads
+    set_meta gcp-k2 acceptance_check_tip "$x2"
+    expect_skip "no change and already judged" gcp-k2 "acceptance-check: SKIP gcp-k2 no-change tip=$x2"
+
+    # A judgment of an OLDER tip is not a skip: a resubmission is read again.
+    reset_beads
+    set_meta gcp-k1 acceptance_check_tip "$older"
+    run_ac packet --work gcp-k1
+    assert_eq "an older judged tip: exit status" 0 "$RC"
+    assert_match "an older judged tip: the first line is the PACKET line" '^acceptance-check: PACKET gcp-k1 ' "$(head -n 1 "$T/out")"
+    assert_read_only "an older judged tip"
+
+    # A bead the store cannot read is an error, not a skip.
+    reset_beads
+    FAIL_SHOW=gcp-k1
+    run_ac packet --work gcp-k1
+    assert_eq "an unreadable bead: exit status" 1 "$RC"
+    assert_eq "an unreadable bead: nothing on stdout" "" "$(cat "$T/out")"
+    end_case
+}
