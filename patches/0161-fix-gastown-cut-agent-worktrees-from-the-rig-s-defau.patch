+
+    [ "$(ref_sha "$wt" HEAD)" = "$(ref_sha "$rig" refs/remotes/origin/main)" ] ||
+        fail "an agreeing rig should still be cut from origin/main; got $(ref_sha "$wt" HEAD)"
+    if grep -q 'differs from origin/HEAD' "$err"; then
