From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Fri, 28 Aug 2026 19:16:08 -0400
Subject: [PATCH 57/59] fix(registry): re-pin gauntlet-tdd 0.1.0 to the
 bare-bd-guard subtree (gcp-dnxq)

29b2205 changed the pack subtree again (the note-write guard's own `bd`
match), so the pin at 25a61a8 named a version of the pack that fails the
repo's bare-bd scanner.

Re-pinned to 29b2205, hash recomputed by validate_registry.py's own
git_pack_content_hash over the gauntlet-tdd subtree at that commit.
---
 registry.toml | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/registry.toml b/registry.toml
index 161c636..74d56e5 100644
--- a/registry.toml
+++ b/registry.toml
@@ -323,6 +323,6 @@ schema = 1
   [[pack.release]]
     version = "0.1.0"
     ref = "main"
-    commit = "25a61a8d6ea4baad60ea160e6d12fde187f11639"
-    hash = "sha256:729ecab80288f93f026383c6235c24f71330191d46213376e1e726c056f7bea0"
+    commit = "29b22053620445ed5926417f2311ab368ad6aa06"
+    hash = "sha256:0a79997472f09d45bb7a0c22d7357d3558594157e25ac359d336c4189a19e683"
     description = "Initial gauntlet-tdd release: the RED-to-GREEN contract loop as one formula (mol-tdd-red-green) plus a wrapper command, pinned to the bats lane with gauntlet lint as the red gate."
-- 
