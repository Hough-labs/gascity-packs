From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Sat, 10 Oct 2026 17:01:50 -0400
Subject: [PATCH 148/148] fix(refinery): count blocked and deferred bugs as
 duplicates too (gcp-fooz4)

The duplicate check's --status list must exclude closed bugs and nothing
else. open,in_progress also dropped blocked and deferred, so a pre-existing
failure whose bug someone had parked on purpose was filed again on the next
red. The drift test now requires both statuses (red against the narrower
list).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 gastown/formulas/mol-refinery-patrol.toml  | 13 +++++++------
 tests/test_prompt_formula_command_drift.py |  6 ++++++
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/gastown/formulas/mol-refinery-patrol.toml b/gastown/formulas/mol-refinery-patrol.toml
index 1e2ede18..e25740dc 100644
--- a/gastown/formulas/mol-refinery-patrol.toml
+++ b/gastown/formulas/mol-refinery-patrol.toml
@@ -1475,19 +1475,20 @@ fi
      # [] — indistinguishable from a genuine miss. Use the failing test name,
      # the tool name, the CVE id (e.g. test_no_bare_bd_commands, govulncheck).
      #
-     # `--status=open,in_progress` is REQUIRED. bd 1.3.x searches every
-     # status, closed included, by default, so without it a bug that was fixed
-     # and closed counts as the duplicate and a REGRESSION of it is never
-     # filed. Do not narrow it further: neither wrong form trips the
-     # fail-closed branch below, because both exit 0:
+     # A `--status` list naming every status EXCEPT closed is REQUIRED. bd
+     # 1.3.x searches every status, closed included, by default, so without it
+     # a bug that was fixed and closed counts as the duplicate and a
+     # REGRESSION of it is never filed. Do not narrow it further: no wrong form
+     # trips the fail-closed branch below, because each exits 0:
      #   no --status                counts closed bugs as live duplicates
      #   --status=open              drops in_progress, and a duplicate someone
      #                              already STARTED is still a duplicate
+     #   dropping blocked/deferred  re-files a bug someone parked on purpose
      # (gcp-h98d forbade this filter for a bd that excluded closed issues from
      # search and answered the comma form with []; bd 1.3.0 does neither.)
      DUP_KEYWORD="<distinctive keyword from the failure>"
      DUP_ERR=$(mktemp)
-     DUP_JSON=$(gc bd search "$DUP_KEYWORD" --type=bug --status=open,in_progress --json 2>"$DUP_ERR")
+     DUP_JSON=$(gc bd search "$DUP_KEYWORD" --type=bug --status=open,in_progress,blocked,deferred --json 2>"$DUP_ERR")
      DUP_CODE=$?
      DUP_MSG=$(cat "$DUP_ERR"); if [ -n "$DUP_ERR" ]; then rm -f "${DUP_ERR:?}"; fi
      DUP_COUNT=$(printf '%s' "$DUP_JSON" | jq 'length' 2>/dev/null)
diff --git a/tests/test_prompt_formula_command_drift.py b/tests/test_prompt_formula_command_drift.py
index b1643f58..86b6bc71 100644
--- a/tests/test_prompt_formula_command_drift.py
+++ b/tests/test_prompt_formula_command_drift.py
@@ -505,6 +505,12 @@ def test_refinery_duplicate_check_counts_only_live_bugs() -> None:
         "(--status names closed or all), so a regression of a fixed bug is never "
         f"filed:\n    {command}"
     )
+    parked = {"blocked", "deferred"} - statuses
+    assert not parked, (
+        f"{REFINERY_PATROL}:{number}: the duplicate check skips {sorted(parked)} "
+        "bugs, so a failure someone parked on purpose is filed again:\n    "
+        f"{command}"
+    )
 
 
 def test_witness_orphan_recovery_resolves_the_rigs_default_branch() -> None:
