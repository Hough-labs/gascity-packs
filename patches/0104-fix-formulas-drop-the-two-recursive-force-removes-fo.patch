From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Sun, 27 Sep 2026 15:51:52 -0400
Subject: [PATCH 104/112] fix(formulas): drop the two recursive force-removes
 for rmdir / warn-and-leave (gcp-l8td.1)

The mill safety hook (dotmill-yuk) is closing a gap: once it collapses a
command to one line it will treat `then rm ...` as command position, so a
recursive force-remove at the start of a line inside a block no longer
escapes it. Two pack formula lines depended on that gap, and every inline
merge-push run would be blocked once it closes (gcp-l8td decision C1).

mol-refinery-patrol, merge_ff_push_cleanup_wt: the parent is now removed
with rmdir, and a WARN is printed if that fails. On the success path
`git worktree remove --force "$mfp_wt"` has already emptied it, because
mfp_wt is "$mfp_parent/target". When worktree remove fails (it is allowed
to, via `|| true`), leaking a temp dir loudly can be recovered from, but
force-deleting a non-empty dir cannot. The function still returns 0, and
none of its callers read its status.

mol-witness-patrol, Step 3b: the fallback force-remove becomes an if-form
check that warns when the worktree path survived `git worktree remove`
and leaves it for inspection. It is the if-form, not &&, so the block's
exit status stays 0.

Out of scope, and untouched per decision C2b: the 13 single-file `rm -f`
lines in the refinery, witness and deacon formulas. No `trash` was
added, since it is macOS-only.

Validation: two new executed cases in test_refinery_merge_push.sh call
the extracted block's own merge_ff_push_cleanup_wt.
test_cleanup_removes_emptied_parent covers the success path.
test_cleanup_leaks_parent_loudly_when_worktree_remove_fails fails RED at
8c983d75 (the old line deletes the non-empty parent and prints no WARN)
and passes GREEN here. The acceptance greps now print 0 recursive-rm
lines and 13 `rm -f` lines (unchanged).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 gastown/formulas/mol-refinery-patrol.toml |  2 +-
 gastown/formulas/mol-witness-patrol.toml  |  2 +-
 gastown/tests/test_refinery_merge_push.sh | 63 +++++++++++++++++++++++
 3 files changed, 65 insertions(+), 2 deletions(-)

diff --git a/gastown/formulas/mol-refinery-patrol.toml b/gastown/formulas/mol-refinery-patrol.toml
index 0f4b0947..559a96c4 100644
--- a/gastown/formulas/mol-refinery-patrol.toml
+++ b/gastown/formulas/mol-refinery-patrol.toml
@@ -1404,7 +1404,7 @@ merge_ff_push_cleanup_wt() {
     git worktree remove --force "$mfp_wt" >/dev/null 2>&1 || true
   fi
   if [ -n "${mfp_parent:-}" ]; then
-    rm -rf "$mfp_parent"
+    rmdir "$mfp_parent" 2>/dev/null || echo "WARN left temp dir $mfp_parent: git worktree remove did not empty it."
   fi
   mfp_wt=""
   mfp_parent=""
diff --git a/gastown/formulas/mol-witness-patrol.toml b/gastown/formulas/mol-witness-patrol.toml
index 7361e4ec..a4d6e34c 100644
--- a/gastown/formulas/mol-witness-patrol.toml
+++ b/gastown/formulas/mol-witness-patrol.toml
@@ -472,7 +472,7 @@ Once the branch is canonical (on origin), the worktree is disposable:
 # Delete worktree if it exists
 cd <rig-root>
 git worktree remove <worktree-path> --force 2>/dev/null
-rm -rf <worktree-path> 2>/dev/null  # Fallback
+if [ -e <worktree-path> ]; then echo "WARN <worktree-path> survived git worktree remove; left for inspection"; fi
 git worktree prune
 ```
 
diff --git a/gastown/tests/test_refinery_merge_push.sh b/gastown/tests/test_refinery_merge_push.sh
index aef9d698..d814ad24 100755
--- a/gastown/tests/test_refinery_merge_push.sh
+++ b/gastown/tests/test_refinery_merge_push.sh
@@ -450,6 +450,67 @@ HOOK
     rm -rf "$tmp"
 }
 
+# Run the block's own cleanup against a given parent and worktree path. Echoes
+# the function's status; its stdout goes to "$3" so a test can read the WARN.
+run_cleanup() {
+    local parent="$1" wt="$2" out="$3"
+    (
+        cd "$WORK" || exit 90
+        # shellcheck disable=SC1090
+        . "$BLOCK"
+        # Consumed by merge_ff_push_cleanup_wt, not by this shell.
+        # shellcheck disable=SC2034
+        mfp_parent="$parent"
+        # shellcheck disable=SC2034
+        mfp_wt="$wt"
+        merge_ff_push_cleanup_wt >"$out" 2>&1
+        echo "$?"
+    )
+}
+
+test_cleanup_removes_emptied_parent() {
+    # The success path: `git worktree remove` empties the scratch parent, and the
+    # cleanup must then remove it without a recursive force-delete (gcp-l8td.1).
+    local tmp parent status
+    tmp=$(mktemp -d)
+    make_rig "$tmp"
+    parent=$(mktemp -d "$tmp/gascity-refinery-merge.XXXXXX")
+    git_q -C "$WORK" worktree add --detach "$parent/target" dev ||
+        fail "harness bug: could not create the merge worktree at $parent/target"
+
+    status=$(run_cleanup "$parent" "$parent/target" "$tmp/cleanup.out")
+
+    [ "$status" = "0" ] ||
+        fail "cleanup of an emptied parent returned $status, want 0"
+    [ ! -e "$parent" ] ||
+        fail "cleanup left the emptied parent $parent behind"
+    rm -rf "$tmp"
+}
+
+test_cleanup_leaks_parent_loudly_when_worktree_remove_fails() {
+    # `git worktree remove` is allowed to fail, and then the parent is not empty.
+    # Leaking a temp dir loudly is recoverable; force-deleting whatever is left in
+    # it is not. The parent and its contents must survive, with a WARN on stdout,
+    # and the cleanup must still return 0 (gcp-l8td.1).
+    local tmp parent status
+    tmp=$(mktemp -d)
+    make_rig "$tmp"
+    parent=$(mktemp -d "$tmp/gascity-refinery-merge.XXXXXX")
+    echo left >"$parent/leftover.txt"
+
+    status=$(run_cleanup "$parent" "$parent/not-a-worktree" "$tmp/cleanup.out")
+
+    [ "$status" = "0" ] ||
+        fail "cleanup after a failed worktree remove returned $status, want 0"
+    [ -d "$parent" ] ||
+        fail "cleanup deleted the non-empty parent $parent — it must be left for inspection"
+    [ -f "$parent/leftover.txt" ] ||
+        fail "cleanup deleted $parent/leftover.txt out of the non-empty parent"
+    grep -q 'WARN left temp dir' "$tmp/cleanup.out" ||
+        fail "cleanup leaked $parent silently; want 'WARN left temp dir' on stdout, got: $(cat "$tmp/cleanup.out")"
+    rm -rf "$tmp"
+}
+
 test_block_does_not_rely_on_set_e() {
     # The abort path must be explicit. `set -e` inside the block would re-create
     # the dependency on shell-option inheritance that produced the false merge.
@@ -478,6 +539,8 @@ test_noop_ff_does_not_report_a_merge
 test_vetoed_push_stops_without_retrying
 test_rejected_push_with_a_moving_target_still_retries
 test_push_carries_an_explicit_gate_wait_budget
+test_cleanup_removes_emptied_parent
+test_cleanup_leaks_parent_loudly_when_worktree_remove_fails
 
 if [ "$FAILURES" -ne 0 ]; then
     echo "refinery merge-push tests: $FAILURES failure(s)" >&2
