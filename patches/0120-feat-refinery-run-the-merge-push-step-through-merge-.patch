-  # when an equivalent patch is already upstream and '+' when it is not. All
-  # '-' with no '+' is the rebasing rig's already-merged fingerprint.
-  bal_cherry=$(git cherry "$bal_target" "$bal_branch" "$bal_fork" 2>/dev/null) || return 2
