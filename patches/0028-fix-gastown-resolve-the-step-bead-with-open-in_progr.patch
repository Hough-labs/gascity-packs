From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Hunter B Hough <git@hough.ink>
Date: Mon, 17 Aug 2026 09:21:04 -0400
Subject: [PATCH 028/148] fix(gastown): resolve the step bead with
 open,in_progress (gcp-rz8a)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Self-review found the step-bead close was inert. A claimed step bead carries
the session's assignee but is still stored `open` — verified live on gcp-vgmf,
assignee gastown__polecat-gc-ow42y, status open. Every query added by this
branch asked for `--status=in_progress` alone, so:

  - submit-and-exit's STEP_BEAD_ID came back empty at all three call sites,
    step 10 printed its WARN, and the step bead stayed open — the respawn loop
    the branch exists to close;
  - the prompt/fragment guard's convoy recovery resolved no root bead, so
    CONVOY_ID stayed empty and the guard still could not run.

Widen all five queries to `--status=open,in_progress`, record why at each site,
and add contract assertions that fail on the `in_progress`-only form.
---
 gastown/agents/polecat/prompt.template.md               | 7 +++++--
 gastown/template-fragments/approval-fallacy.template.md | 7 +++++--
 gastown/tests/test_gastown_pack_assets.sh               | 4 ++++
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/gastown/agents/polecat/prompt.template.md b/gastown/agents/polecat/prompt.template.md
index 99d788cb..beaba781 100644
--- a/gastown/agents/polecat/prompt.template.md
+++ b/gastown/agents/polecat/prompt.template.md
@@ -433,10 +433,13 @@ handed to somebody else — means submit-and-exit already ran. Otherwise run it:
 EXPECTED_ASSIGNEE="${BEADS_ACTOR:-${GC_SESSION_NAME:-${GC_SESSION_ID:-${GC_AGENT:-}}}}"
 # `$GC_BEAD_ID` is not always exported — it was empty in gcp-rz8a's session, so
 # this guard could not run at all. Recover the convoy from the molecule root of
-# the step bead this session is holding rather than skipping the check.
+# the step bead this session is holding rather than skipping the check. The
+# status filter is `open,in_progress`: a claimed step bead carries this
+# session's assignee but is still stored `open`, so `in_progress` alone matches
+# nothing and the recovery silently yields no convoy.
 CONVOY_ID="${GC_BEAD_ID:-}"
 if [ -z "$CONVOY_ID" ]; then
-  ROOT_BEAD_ID=$(gc bd list --assignee="$EXPECTED_ASSIGNEE" --status=in_progress \
+  ROOT_BEAD_ID=$(gc bd list --assignee="$EXPECTED_ASSIGNEE" --status=open,in_progress \
     --has-metadata-key gc.step_ref --include-infra --limit=0 --json 2>/dev/null |
     jq -r '[.[] | .metadata."gc.root_bead_id" // empty] | .[0] // empty' 2>/dev/null)
   if [ -n "$ROOT_BEAD_ID" ]; then
diff --git a/gastown/template-fragments/approval-fallacy.template.md b/gastown/template-fragments/approval-fallacy.template.md
index b4d4ae99..5d60014e 100644
--- a/gastown/template-fragments/approval-fallacy.template.md
+++ b/gastown/template-fragments/approval-fallacy.template.md
@@ -36,10 +36,13 @@ means submit-and-exit already reassigned it. Otherwise run it:
 EXPECTED_ASSIGNEE="${BEADS_ACTOR:-${GC_SESSION_NAME:-${GC_SESSION_ID:-${GC_AGENT:-}}}}"
 # `$GC_BEAD_ID` is not always exported — it was empty in gcp-rz8a's session, so
 # this guard could not run at all. Recover the convoy from the molecule root of
-# the step bead this session is holding rather than skipping the check.
+# the step bead this session is holding rather than skipping the check. The
+# status filter is `open,in_progress`: a claimed step bead carries this
+# session's assignee but is still stored `open`, so `in_progress` alone matches
+# nothing and the recovery silently yields no convoy.
 CONVOY_ID="${GC_BEAD_ID:-}"
 if [ -z "$CONVOY_ID" ]; then
-  ROOT_BEAD_ID=$(gc bd list --assignee="$EXPECTED_ASSIGNEE" --status=in_progress \
+  ROOT_BEAD_ID=$(gc bd list --assignee="$EXPECTED_ASSIGNEE" --status=open,in_progress \
     --has-metadata-key gc.step_ref --include-infra --limit=0 --json 2>/dev/null |
     jq -r '[.[] | .metadata."gc.root_bead_id" // empty] | .[0] // empty' 2>/dev/null)
   if [ -n "$ROOT_BEAD_ID" ]; then
diff --git a/gastown/tests/test_gastown_pack_assets.sh b/gastown/tests/test_gastown_pack_assets.sh
index 0831e98d..9a5b8bc1 100755
--- a/gastown/tests/test_gastown_pack_assets.sh
+++ b/gastown/tests/test_gastown_pack_assets.sh
@@ -884,6 +884,10 @@ PY
             fail "$(basename "$guard") must not read the convoy straight from \$GC_BEAD_ID; it is not always exported"
         grep -F 'gc.root_bead_id' "$guard" >/dev/null ||
             fail "$(basename "$guard") must recover the convoy from the step bead's molecule root"
+        grep -F -- '--status=open,in_progress' "$guard" >/dev/null ||
+            fail "$(basename "$guard") must query the held step bead with --status=open,in_progress"
+        ! grep -F -- '--status=in_progress ' "$guard" >/dev/null ||
+            fail "$(basename "$guard") queries a claimed step bead, which is stored open, not in_progress"
         ! grep -F '[ "$WORK_STATUS" != "in_progress" ]' "$guard" >/dev/null ||
             fail "$(basename "$guard") must not treat an unassigned work bead as already submitted"
         grep -F '[ "$WORK_STATUS" = "closed" ]' "$guard" >/dev/null ||
