 .../assets/scripts/polecat-worktree-reap.sh   | 106 ++++++++++--
 gastown/formulas/mol-witness-patrol.toml      |  21 ++-
 gastown/tests/test_polecat_worktree_reap.sh   | 153 ++++++++++++++++++
 4 files changed, 274 insertions(+), 16 deletions(-)

