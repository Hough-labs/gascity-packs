 {"children":[{"id":"winnow-pcpn6","status":"in_progress"}]}
 JSON
     cat >"$dir/work.json" <<JSON
-[{"id":"winnow-pcpn6","status":"in_progress","assignee":"$owner_assignee","metadata":{"gc.session_id":"gc-8a4d"}}]
