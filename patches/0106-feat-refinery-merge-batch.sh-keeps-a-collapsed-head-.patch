+        ;;
+      *)
+        sb_degrade "could not tell whether the head carries a change"
+        return 0
+        ;;
+    esac
+  fi
   if [ "$stk_batchable" -eq 1 ]; then
     # A for loop, not a read loop, for the reason select gives.
     for stk_id in $stk_ids; do
@@ -628,6 +666,54 @@ lb_land_members() {
