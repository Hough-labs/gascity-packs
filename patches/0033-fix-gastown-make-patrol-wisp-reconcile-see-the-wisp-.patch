+  exit 1
 fi
 SURPLUS_WISPS=$(gc bd list --assignee="$GC_AGENT" --status=open,in_progress --type=molecule --include-infra --limit=0 --json \
   | jq -r --arg cur "$CURRENT_WISP" '.[] | select(.id != $cur) | .id')
@@ -739,7 +756,7 @@ fi
