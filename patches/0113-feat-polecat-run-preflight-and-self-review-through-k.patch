+PHASE_CMD='<the red phase command, for an id that is not go:, bats: or pytest:>'
+git fetch origin {{base_branch}}
+T=$(mktemp -d "${TMPDIR:-/tmp}/base-rerun.XXXXXX")
+git worktree add --detach "$T" origin/{{base_branch}}
+case "$ID" in
+go:*.Test*) GO_REST=${ID#go:}; GO_PKG=${GO_REST%%.Test*}; ( cd "$T" && go test "./$GO_PKG" -run "^${GO_REST#"$GO_PKG".}$" -count=1 ) ;;
+bats:*::*) BATS_REST=${ID#bats:}; ( cd "$T" && bats -f "${BATS_REST#*::}" "${BATS_REST%%::*}" ) ;;
