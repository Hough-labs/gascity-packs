+# write_manifest_of <id>... — what find-work and stack write for a batch: the head
+# first, and the fields stack records beside the members.
+write_manifest_of() {
+    local members
+    members=$(printf '%s\n' "$@" |
+        jq -R '{id: ., branch: ("polecat/" + .), tip: "t1", commits: 1, patch_id: "p1"}' | jq -s .)
