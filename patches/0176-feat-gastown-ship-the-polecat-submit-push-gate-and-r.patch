+test_script_holds_no_formula_placeholder() {
+    [ "$(grep -c '{{' "$SUBMIT")" = 0 ] || fail "$SUBMIT must hold no {{...}}: gc renders the step text, not the script"
+    bash -n "$SUBMIT" || fail "the script is not valid bash"
+}
