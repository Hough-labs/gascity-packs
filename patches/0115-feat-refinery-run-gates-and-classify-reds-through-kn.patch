+3. If pre-existing on target (every diagnosed red is on `$TARGET` too):
+   - File through known-red FIRST, in a fence of its own. It reads the
+     known-red path step 0 left in the git dir and never resolves one itself.
+     known-red dedups by exact failure id: it refreshes last-seen on a KNOWN
+     id, files every NEW id with a stable id as ONE base-red bead under its
+     gate's phase, and files nothing for a FIXED-UPSTREAM id. That red
+     reproduces on `$TARGET` although its bead is closed, so the witness is
+     told.
+     ```bash
+     # --- refinery-known-red-file:begin ---
+     GATE_LOG="$(git rev-parse --git-dir)/refinery-gate.log"
+     KR=$(cat "$(git rev-parse --git-dir)/refinery-known-red.path" 2>/dev/null)
+     if [ -z "$KR" ]; then
+         echo "known-red did not run in step 0: use the DUP_KEYWORD block below for every red."
+     else
+         FILE_OUT=$("$KR" file "$GATE_LOG" --summary "red on $TARGET at refinery merge of $WORK" --from "$WORK" 2>&1)
+         FILE_CODE=$?
+         printf '%s\\n' "$FILE_OUT"
+         case "$FILE_CODE" in
+         0|1)
+             FIXED=$(printf '%s\\n' "$FILE_OUT" |
+                 sed -nE 's/^known-red: (.+) is fixed upstream by ([^;]+);.*/\\1 (\\2)/p' | paste -sd ' ' -)
+             if [ -n "$FIXED" ]; then
+                 gc session nudge "${GC_RIG:+$GC_RIG/}{{binding_prefix}}witness" \\
+                     "$(printf 'KNOWN-RED: %s reproduce on %s although the bead is closed' "$FIXED" "$TARGET" | cut -c1-200)"
+             fi
+             if [ "$FILE_CODE" -eq 0 ]; then
+                 FILED=$(printf '%s\\n' "$FILE_OUT" | awk '$1 == "known-red:" && $2 == "filed" { print $3 }' | paste -sd ' ' -)
+                 echo "FILED: ${FILED:-none}. Proceed with merge."
+             else
+                 printf '%s\\n' "$FILE_OUT" | awk '$1 ~ /^raw:/'
+                 echo "These reds have no stable id: run the DUP_KEYWORD block below for them only."
+             fi
+             ;;
+         *)
+             # FAIL CLOSED, as the DUP_KEYWORD block does: a failed file may
+             # still have created a bead, so never fall through to filing.
+             gc mail send mayor/ -s "ESCALATION: refinery known-red file failed, not filing [HIGH]" -m "Work bead: $WORK
+     Exit code: $FILE_CODE
+     Output: $FILE_OUT
+     Refused to file a pre-existing-failure bead: known-red file failed, and a create can land and still fail."
+             gc session nudge "${GC_RIG:+$GC_RIG/}{{binding_prefix}}witness" "KNOWN-RED HALT: $WORK — known-red file exited $FILE_CODE; refused to file. Merge not attempted."
+             echo "STOP. known-red file failed. NEVER fall through to filing."
+             gc runtime drain-ack
+             exit 1
+             ;;
+         esac
+     fi
+     # --- refinery-known-red-file:end ---
+     ```
