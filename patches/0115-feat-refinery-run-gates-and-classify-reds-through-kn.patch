-If run_tests = "true":
 ```bash
-{{test_command}}
+# --- gate-run:begin ---
+# gate_run <phase> '<command>' appends one segment known-red can read to
+# $GATE_LOG: a `gate(<phase>): RUN` header, the command's output, then
+# `gate(<phase>): PASS` or `gate(<phase>): FAIL`. An empty command is a phase
+# the rig does not configure: it writes nothing and returns 0. The command is
+# passed single-quoted and eval'd, so double quotes and $(...) in it work.
+gate_run() {
+    gr_phase="$1"
+    gr_cmd="$2"
+    [ -n "${gr_cmd//[[:space:]]/}" ] || return 0
+    echo "gate($gr_phase): RUN $(printf '%s' "$gr_cmd" | tr -s '[:space:]' ' ')" | tee -a "$GATE_LOG"
+    if ( eval "$gr_cmd" ) </dev/null >>"$GATE_LOG" 2>&1; then
+        echo "gate($gr_phase): PASS" | tee -a "$GATE_LOG"
+        return 0
+    fi
+    echo "gate($gr_phase): FAIL" >>"$GATE_LOG"
+    tail -n 40 "$GATE_LOG"
+    return 1
+}
+# --- gate-run:end ---
+# --- refinery-gates:begin ---
+# One log per merge attempt: truncated first, so a FAIL from an earlier
+# attempt is never read as this one's.
+GATE_LOG="$(git rev-parse --git-dir)/refinery-gate.log"
+: > "$GATE_LOG"
+gate_run setup '{{setup_command}}' || true
+gate_run typecheck '{{typecheck_command}}' || true
+gate_run lint '{{lint_command}}' || true
+gate_run build '{{build_command}}' || true
+if [ "{{run_tests}}" = "true" ]; then gate_run test '{{test_command}}' || true; fi
+grep -E '^gate\\([A-Za-z0-9_-]*\\): (PASS|FAIL)$' "$GATE_LOG"
+# --- refinery-gates:end ---
 ```
 
