+
+```bash
+# --- resolve-known-red:begin ---
+# resolve_known_red <formula> prints the path of the pack's known-red and
+# returns 0, or returns 1. Located the way mol-refinery-patrol's
+# resolve_approval_gate is: the named formula's own source anchors the pack, so
+# the matcher is always the copy shipped beside the formula being run.
+# GC_PACK_DIR is only a fallback, because gc exports it to pack commands and
+# not to agent shells.
+resolve_known_red() {
+    rkr_rel="assets/scripts/known-red"
+    rkr_city="${GC_CITY:-${GC_CITY_PATH:-}}"
+    if [ -n "$rkr_city" ]; then
+        rkr_json=$(gc formula list --city "$rkr_city" --json 2>/dev/null)
+    else
+        rkr_json=$(gc formula list --json 2>/dev/null)
+    fi
+    rkr_src=$(printf '%s' "$rkr_json" |
+        jq -r --arg f "$1" '.formulas[]? | select(.name == $f) | .source // empty' 2>/dev/null |
+        head -1)
+    if [ -n "$rkr_src" ]; then
+        # <pack>/formulas/<formula>.toml -> <pack>
+        rkr_pack=$(dirname "$(dirname "$rkr_src")")
+        if [ -x "$rkr_pack/$rkr_rel" ]; then
+            echo "$rkr_pack/$rkr_rel"
+            return 0
+        fi
+    fi
+    if [ -n "${GC_PACK_DIR:-}" ] && [ -x "$GC_PACK_DIR/$rkr_rel" ]; then
+        echo "$GC_PACK_DIR/$rkr_rel"
+        return 0
+    fi
+    return 1
+}
+# --- resolve-known-red:end ---
+# --- refinery-known-red-match:begin ---
+KR=$(resolve_known_red mol-refinery-patrol) || KR=""
+GATE_LOG="$(git rev-parse --git-dir)/refinery-gate.log"
+# §3 runs in a later fence, after the diagnosis, and shell state does not
+# survive between fences. This file hands it the known-red that ran here, so
+# §3 needs no resolve of its own. Empty means known-red did not run.
+KR_PATH_FILE="$(git rev-parse --git-dir)/refinery-known-red.path"
+: > "$KR_PATH_FILE"
+if [ -z "$KR" ] || [ ! -s "$GATE_LOG" ]; then
+    echo "WARN known-red unavailable; diagnose and file by hand (§1-§3 without known-red)"
+else
+    printf '%s\\n' "$KR" > "$KR_PATH_FILE"
+    KR_OUT=$("$KR" match "$GATE_LOG" 2>&1)
+    KR_CODE=$?
+    printf '%s\\n' "$KR_OUT"
+    case "$KR_CODE" in
+    0)
+        KNOWN_IDS=$(printf '%s\\n' "$KR_OUT" | awk '$1 == "KNOWN" { print $2 }' | sort -u | paste -sd ' ' -)
+        gc bd note "$WORK" --stdin <<KNOWN_RED_NOTE
+Refinery merge onto $TARGET: every red is already known (known-red match exit 0). Filed nothing.
+KNOWN: $KNOWN_IDS
+KNOWN_RED_NOTE
+        echo "ALL REDS KNOWN: $KNOWN_IDS. Filed nothing. Close this step and proceed to merge-push."
+        ;;
+    1|3)
+        echo "DIAGNOSE these reds (branch versus $TARGET):"
+        printf '%s\\n' "$KR_OUT" | awk '$1 == "NEW" || $1 == "FIXED-UPSTREAM"'
+        echo "KNOWN reds in the same log need no diagnosis."
+        ;;
+    *)
+        echo "WARN known-red lookup failed (exit $KR_CODE); diagnose every red"
+        ;;
+    esac
+fi
+# --- refinery-known-red-match:end ---
+```
