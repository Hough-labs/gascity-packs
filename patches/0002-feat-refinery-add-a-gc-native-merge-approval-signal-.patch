+test_gate_resolves_pr_without_gh_cli() {
+    local tmp bin bead pr status output
+    tmp=$(mktemp -d)
+    bin="$tmp/bin"
+    bead="$tmp/bead.json"
+    pr="$tmp/pr.json"
+    mkdir -p "$bin"
+    write_gc_stub "$bin"
