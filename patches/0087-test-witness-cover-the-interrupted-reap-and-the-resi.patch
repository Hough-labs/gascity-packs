+
+    # And the flag itself must still not be wired. Every mention has to be prose.
+    local wired
+    wired=$(grep -n -- '--no-dry-run' "$toml" | grep -v '^[0-9]*:#' || true)
+    [[ -z "$wired" ]] ||
+        fail "--no-dry-run appears outside the prose: ${wired//$'\n'/ | }"
