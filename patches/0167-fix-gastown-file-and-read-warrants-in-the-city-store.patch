+    assert warrant_city_store_violations(fixture, f2)
+    # F3: a guarded block whose dedupe query reads the rig store.
+    f3 = block(
+        city_def,
+        dedupe + " \\",
+        jq_tail,
+        *refusal_arm,
+        "  echo skip",
