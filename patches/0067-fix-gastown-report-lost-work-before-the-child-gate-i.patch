 gastown/assets/scripts/polecat-home-audit.sh | 86 ++++++++++++++------
 gastown/formulas/mol-witness-patrol.toml     |  2 +-
 gastown/tests/test_polecat_home_audit.sh     | 68 ++++++++++++++++
 3 files changed, 128 insertions(+), 28 deletions(-)

