+# assignments (GC_SESSION_NAME=... GC_SESSION_ID=...).
 run_guard() {
     local dir="$1" owner_assignee="$2" me="$3" step_ref="${4-mol-polecat-work.implement}"
     local root_meta="${5-\"gc.root_bead_id\":\"winnow-5azcp\",}"
