index 18a0b17..46941d7 100644
--- a/gastown/formulas/mol-refinery-patrol.toml
+++ b/gastown/formulas/mol-refinery-patrol.toml
@@ -461,19 +461,66 @@ if [ "$APPROVAL_REQUIRED" -eq 1 ] && [ "$MERGE_STRATEGY" = "direct" ]; then
   echo "require_merge_approval is on; a reviewed merge needs a pull request — using merge_strategy=mr."
