+      return 2
+    fi
+
+    echo "merge-ff-push: landed $BRANCH on $TARGET at $MERGED_SHA (target advanced $BEFORE_SHA -> $AFTER_SHA)."
+    return 0
+  done
+
+  echo "merge-ff-push: could not land $BRANCH on $TARGET in $mfp_max attempts; the target keeps moving. STOP. Do not mutate bead state."
+  return 6
