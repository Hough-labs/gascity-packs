#!/usr/bin/env python3
# VENDORED from dotmill d674c68, library/skills/gascity/known-red/scripts/
# known-red (sha256 5567aa7917be956d9b0b2c7e6e0b8cae5b10c6c00db89fe7c7577a9ea43ccb78),
# so the gastown pack ships its own matcher (gc-cgxps Q2, gcp-4ngf).
# Adaptations from the mill copy:
#   a. Every ledger call runs `gc bd ...`, never a bare binary, so it reads the
#      store gc resolves for this directory. Timeout and fail-closed behaviour
#      are unchanged: gc missing or erroring means every failure is NEW and
#      nothing is filed (exit 2). The git calls are unchanged.
#   b. Docstring, comment and message mentions of ledger verbs say `gc bd`, so
#      tests/test_no_bare_bd_commands.py passes without an allowlist entry.
#   c. A pytest id rule: `FAILED <nodeid>` / `ERROR <nodeid>` with `::` in the
#      nodeid, optionally followed by ` - <message>`, yields pytest:<nodeid> as
#      pytest printed it. `ERROR <path>.py ...` with no `::` (a collection
#      error) stays raw:, and marks its segment red.
# Keep in step with the mill copy: port id-rule changes both ways.
"""known-red — is this red already known on the base branch?

Matches the failures in a gate log against the rig's base-red ledger by EXACT
failure id, so a red that is already on the base branch gets cited instead of
re-diagnosed, and a new red is never hidden behind a known one.

  known-red list  [--phase P] [--stale]
  known-red match <log|->
  known-red file  <log|-> --summary "..." [--from <work-bead>] [--into <bead>]
                  [--phase P] [--sha SHA] [--seen-at UTC] [--dry-run]
  known-red sigs  <log|->

WHY THIS EXISTS (gc-cgxps, retro 2026-09-24)
winnow-lqft1 was A/B-diagnosed by 7 agents and winnow-vn65m collected 11 repro
notes, because nothing recorded a red as known in a form a tool could match.
Duplicate beads piled up for the same red (govulncheck x3, groups flake x4)
because the polecat steps file without searching first.

RULES THIS SCRIPT ENCODES
- A signature is an exact id (go:<pkg>.<Test>, bats:<file>::<name>, ...),
  never a regex and never a lane line. `gate(test): FAIL — ...` matching would
  let a known red mask a new one in the same lane.
- A red segment of the log that yields no id becomes raw:<line>, which is
  always NEW. So a known red in one lane cannot hide an unparsed red in another.
- The lookup fails closed: if `gc bd` or git cannot answer, every failure is
  NEW and nothing is filed (exit 2).
- One status per `gc bd list` call. A repeated --status is not a union; the
  last one wins and the query returns a confident zero.
- Metadata is written only with `gc bd update --set-metadata key=value`, and
  every write is read back: a bead whose metadata column is not a JSON object
  freezes every pool create in its rig.

Exit codes
  match: 0 every id KNOWN; 1 any id NEW (or no id found); 2 lookup failed;
         3 nothing NEW but some id FIXED-UPSTREAM (rebase).
  file:  0 done; 1 raw lines left unfiled; 2 lookup or write failed.
  list:  0 listed; 2 lookup failed.
  sigs:  0 ids printed; 1 no id found.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timedelta, timezone

LABEL = "base-red"
# A deferred or blocked base-red bead is still red on base. Each status is its
# own `gc bd list` call (see the header).
ACTIVE_STATUSES = ("open", "in_progress", "blocked", "deferred")
STALE_AFTER = timedelta(hours=72)
CLOSED_WINDOW = timedelta(days=7)
BD_TIMEOUT = 60

NOW = datetime.now(timezone.utc)


def utc(ts):
    return ts.strftime("%Y-%m-%dT%H:%M:%SZ")


class LookupFailed(Exception):
    pass


class WriteFailed(Exception):
    pass


# --------------------------------------------------------------------------
# Extraction: gate log -> ordered, de-duplicated failure ids
# --------------------------------------------------------------------------

ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]")
# `bun run --filter` prefixes every line with "<@scope/pkg> <script>: ".
BUN_PREFIX = re.compile(r"^@[\w.-]+/[\w.-]+ [\w:.-]+: ?")
RUN = re.compile(r"^gate\(([\w-]+)\): RUN\s+(.*)$")
GATE_PHASE = re.compile(r"^gate\(([\w-]+)\):")
LANE_DIR = re.compile(r"\bcd\s+([^\s&;'\"]+)\s*&&")

# A segment (the output of one `gate(P): RUN` step) is red if any line matches.
# The second pattern is gate.sh's own RECEIPT_FAILURE_RE.
INDICATORS = [re.compile(p) for p in (
    r"^gate\([\w-]+\): (FAIL|FATAL)\b",
    r"^(FAIL|--- FAIL|panic: |make: \*\*\*|not ok )",
    r"^ ?FAIL\s",                                # jest / vitest file lines
    r"^\s+\d+ failed\s*$",                       # playwright summary
    r"✖ \d+ problems? \([1-9]\d* errors?",       # eslint with errors
    r"^\d+ issues?:\s*$",                        # golangci-lint summary
    r"^In \S+ line \d+:\s*$",                    # shellcheck
    r"^SHELL LINT FAILED",
    r"(?i)exited with code [1-9]",               # bun script / filter exit
    r"^ERROR \S+\.py\b",                         # pytest error (FAILED is above)
)]

GO_FAIL_TEST = re.compile(r"^\s*--- FAIL: (\S+)")
GO_TIMEOUT = re.compile(r"^panic: test timed out after ")
GO_PKG_FAIL = re.compile(r"^FAIL\t(\S+)")
GO_PKG_DONE = re.compile(r"^(ok|\?)\s+\S")
BATS_NOT_OK = re.compile(r"^not ok \d+ (.+?)\s*$")
BATS_FILE = re.compile(r"in test file (.+?), line \d+")
# pytest's short summary. The lazy nodeid stops at the first " - <message>".
PYTEST_ID = re.compile(r"^(?:FAILED|ERROR) (\S+?::.+?)(?: - .*)?\s*$")
PYTEST_ERROR = re.compile(r"^ERROR \S+\.py\b")   # no nodeid: a collection error
VITEST_CASE = re.compile(r"^ ?FAIL\s+(\S+) > (.+?)\s*$")
VITEST_SUITE = re.compile(r"^ ?FAIL\s+(\S+) \[ .+ \]\s*$")
JEST_FILE = re.compile(r"^ ?(FAIL|PASS) +(\S+?)(?: +\(.*\))?\s*$")
JEST_CASE = re.compile(r"^\s+● (.+?)\s*$")
PW_CASE = re.compile(
    r"^\s+(?:\d+\)|[✘×]\s+\d+) (?:\[[^\]]+\] › )?(\S+?):\d+:\d+ › (.+?)"
    r"(?: \(retry #\d+\))?(?: \([\d.]+m?s\))?\s*─*\s*$")
GOLANGCI = re.compile(r"^(\S+\.go):\d+(?::\d+)?: .*\(([a-z][a-z0-9-]*)\)\s*$")
GOLANGCI_TIMEOUT = re.compile(
    r"Timeout exceeded: try increasing it by passing --timeout option"
    r"|golangci-lint.*(deadline exceeded|timed out)", re.I)
ESLINT_FILE = re.compile(r"^(/\S+\.(?:[cm]?[jt]sx?|vue|svelte))\s*$")
ESLINT_ERROR = re.compile(r"^\s+\d+:\d+\s+error\s")
SHELLCHECK_TTY = re.compile(r"^In (\S+) line \d+:\s*$")
SHELLCHECK_GCC = re.compile(
    r"^(\S+):\d+:\d+: (?:error|warning|note|info|style): .*\[SC\d+\]\s*$")


class Failure:
    def __init__(self, sig, phase, evidence):
        if sig.startswith("raw:"):
            sig = re.sub(r"\s+", " ", sig.strip())[:204]
        self.sig = sig
        self.phase = phase
        self.evidence = evidence.strip()[:300]

    @property
    def raw(self):
        return self.sig.startswith("raw:")


class Paths:
    """Makes a path repo-relative, so one red has one id in every worktree."""

    def __init__(self):
        self.top = git_out(["rev-parse", "--show-toplevel"])

    def rel(self, p, lane_dir=None):
        if not os.path.isabs(p):
            if lane_dir:
                p = os.path.join(lane_dir, p)
            return os.path.normpath(p)
        top = self.top
        if not top:
            return p
        if p.startswith(top + "/"):
            return p[len(top) + 1:]
        # Another worktree of the same repo: the longest suffix of at least two
        # components that exists here. No match keeps the absolute path, which
        # can only ever be NEW; that is the safe direction.
        parts = p.strip("/").split("/")
        for i in range(1, len(parts) - 1):
            cand = "/".join(parts[i:])
            if os.path.exists(os.path.join(top, cand)):
                return cand
        return p


def gopkg(pkg):
    """github.com/ferth-ai/winnow/internal/x -> internal/x (module-relative)."""
    parts = pkg.split("/")
    if "." in parts[0] and len(parts) >= 3:
        return "/".join(parts[3:]) or "."
    return pkg


def title(t):
    return re.sub(r"\s+[›>]\s+", " > ", t.strip())


def segments(lines):
    segs = [{"phase": None, "cmd": "", "lines": []}]
    phase = None
    for line in lines:
        m = RUN.match(line)
        if m:
            phase = m.group(1)
            segs.append({"phase": phase, "cmd": m.group(2), "lines": []})
        elif phase is None:
            g = GATE_PHASE.match(line)
            if g:
                phase = g.group(1)
                segs[0]["phase"] = phase
        segs[-1]["lines"].append(line)
    for s in segs:
        s["phase"] = s["phase"] or phase or "unknown"
        m = LANE_DIR.search(s["cmd"])
        s["lane_dir"] = m.group(1) if m else None
    return segs


def red_line(seg):
    for line in seg["lines"]:
        if any(p.search(line) for p in INDICATORS):
            return line
    return None


def extract_segment(seg, paths):
    out = []
    phase, lane = seg["phase"], seg["lane_dir"]
    lines = seg["lines"]

    def add(sig, ev):
        out.append(Failure(sig, phase, ev))

    go_tests, go_timeout = [], None
    jest_file = None
    eslint_file = None
    for i, line in enumerate(lines):
        # go test
        m = GO_FAIL_TEST.match(line)
        if m:
            go_tests.append((m.group(1), line))
            continue
        if GO_TIMEOUT.match(line):
            go_timeout = line
            continue
        m = GO_PKG_FAIL.match(line)
        if m:
            pkg = gopkg(m.group(1))
            for name, ev in go_tests:
                add(f"go:{pkg}.{name}", ev)
            if go_timeout:
                add(f"go-timeout:{pkg}", go_timeout)
            if not go_tests and not go_timeout:
                add(f"raw:{line.strip()}", line)   # build failure, TestMain, ...
            go_tests, go_timeout = [], None
            continue
        if GO_PKG_DONE.match(line):
            go_tests, go_timeout = [], None
        # bats
        m = BATS_NOT_OK.match(line)
        if m:
            name = re.sub(r" in \d+ms$", "", m.group(1))
            f = None
            for nxt in lines[i + 1:]:
                if not nxt.startswith("#"):
                    break
                fm = BATS_FILE.search(nxt)
                if fm:
                    f = fm.group(1)
                    break
            if f:
                add(f"bats:{paths.rel(f)}::{name}", line)
            else:
                add(f"raw:{line.strip()}", line)
            continue
        # pytest. A collection error has no nodeid, so it is raw: here rather
        # than dropped: a pytest id elsewhere in the segment would otherwise
        # stop extract() falling back to raw for it.
        m = PYTEST_ID.match(line)
        if m:
            add(f"pytest:{m.group(1)}", line)
            continue
        if PYTEST_ERROR.match(line):
            add(f"raw:{line.strip()}", line)
            continue
        # vitest (before jest: both start with FAIL)
        m = VITEST_CASE.match(line)
        if m:
            add(f"js:{paths.rel(m.group(1), lane)}::{title(m.group(2))}", line)
            continue
        m = VITEST_SUITE.match(line)
        if m:
            add(f"js:{paths.rel(m.group(1), lane)}::Test suite failed to run", line)
            continue
        # jest
        m = JEST_FILE.match(line)
        if m:
            jest_file = m.group(2) if m.group(1) == "FAIL" else None
            continue
        if line.startswith(("Test Suites:", "Summary of all failing tests")):
            jest_file = None
            continue
        m = JEST_CASE.match(line)
        if m and jest_file and m.group(1) != "Console":
            add(f"js:{paths.rel(jest_file, lane)}::{title(m.group(1))}", line)
            continue
        # playwright
        m = PW_CASE.match(line)
        if m:
            add(f"js:{paths.rel(m.group(1), lane)}::{title(m.group(2))}", line)
            continue
        # lint
        m = GOLANGCI.match(line)
        if m:
            add(f"lint:{m.group(2)}:{paths.rel(m.group(1))}", line)
            continue
        if GOLANGCI_TIMEOUT.search(line):
            add("lint-timeout:golangci-lint", line)
            continue
        stripped = BUN_PREFIX.sub("", line)
        m = ESLINT_FILE.match(stripped)
        if m:
            eslint_file = m.group(1)
            continue
        if eslint_file and ESLINT_ERROR.match(stripped):
            add(f"lint:eslint:{paths.rel(eslint_file)}", f"{eslint_file}: {stripped}")
            continue
        m = SHELLCHECK_TTY.match(line) or SHELLCHECK_GCC.match(line)
        if m:
            add(f"lint:shellcheck:{paths.rel(m.group(1))}", line)
            continue
    for name, ev in go_tests:
        add(f"raw:{ev.strip()}", ev)    # --- FAIL with no FAIL<TAB>pkg line
    if go_timeout:
        add(f"raw:{go_timeout.strip()}", go_timeout)
    return out


def extract(text, paths):
    lines = [ANSI.sub("", ln).rstrip("\r\n") for ln in text.splitlines()]
    fails, seen = [], set()
    for seg in segments(lines):
        first_red = red_line(seg)
        if first_red is None:
            continue   # a green segment contributes nothing (flaky retries, noise)
        got = extract_segment(seg, paths)
        if not got:
            got = [Failure(f"raw:{first_red}", seg["phase"], first_red)]
        for f in got:
            if f.sig not in seen:
                seen.add(f.sig)
                fails.append(f)
    return fails


def read_log(path):
    if path == "-":
        return sys.stdin.read()
    with open(path, encoding="utf-8", errors="replace") as fh:
        return fh.read()


# --------------------------------------------------------------------------
# Ledger
# --------------------------------------------------------------------------

def git_out(args):
    try:
        r = subprocess.run(["git", *args], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def bd(args):
    try:
        r = subprocess.run(["gc", "bd", *args], capture_output=True, text=True, timeout=BD_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)
    return r.returncode, r.stdout, r.stderr


def bd_json(args):
    rc, out, err = bd(args)
    if rc != 0:
        raise LookupFailed(f"`gc bd {' '.join(args)}` exited {rc}: {err.strip()[:300]}")
    try:
        return json.loads(out)
    except ValueError:
        raise LookupFailed(f"`gc bd {' '.join(args)}` did not return JSON: {out.strip()[:200]}")


def bd_list(status, extra=()):
    rows = bd_json(["list", "--label", LABEL, "--status", status, *extra,
                    "--json", "--brief", "--limit", "0"])
    if not isinstance(rows, list):
        raise LookupFailed(f"`gc bd list --status {status}` returned {type(rows).__name__}, not a list")
    return rows


def ledger(include_closed):
    rc, out, err = bd(["config", "get", "issue_prefix"])
    scope = out.strip().splitlines()[-1] if rc == 0 and out.strip() else ""
    if not scope:
        raise LookupFailed(f"cannot name this directory's ledger (`gc bd config get issue_prefix` exited {rc}: {err.strip()[:200]})")
    active = []
    for st in ACTIVE_STATUSES:
        active += bd_list(st)
    closed = bd_list("closed", ["--closed-after", utc(NOW - CLOSED_WINDOW)]) if include_closed else []
    return scope, active, closed


def meta(bead):
    md = bead.get("metadata")
    return md if isinstance(md, dict) else {}


def bead_sigs(bead):
    s = meta(bead).get("base_red_sigs")
    if not isinstance(s, str):
        return []
    return [x.strip() for x in s.split("\n") if x.strip()]


def sig_index(beads):
    idx = {}
    for b in beads:
        for s in bead_sigs(b):
            idx.setdefault(s, [])
            if b["id"] not in idx[s]:
                idx[s].append(b["id"])
    return idx


def fix_on_head(bead_id):
    """True when HEAD's history has a commit citing bead_id. Grep the message,
    not SHA ancestry: squash and rebase merges make --is-ancestor lie."""
    try:
        r = subprocess.run(["git", "log", "-F", f"--grep={bead_id}", "--format=%B%x1e", "HEAD"],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise LookupFailed(f"git log --grep={bead_id} failed: {e}")
    if r.returncode != 0:
        raise LookupFailed(f"git log --grep={bead_id} exited {r.returncode}: {r.stderr.strip()[:200]}")
    exact = re.compile(r"(?<![A-Za-z0-9_.-])" + re.escape(bead_id) + r"(?![A-Za-z0-9_-]|\.[A-Za-z0-9])")
    return any(exact.search(msg) for msg in r.stdout.split("\x1e"))


def classify(fails, active, closed):
    """-> [(cls, [bead ids], Failure, note)]"""
    known, gone = sig_index(active), sig_index(closed)
    res = []
    for f in fails:
        if f.raw:
            res.append(("NEW", [], f, "no stable id; always NEW"))
        elif f.sig in known:
            res.append(("KNOWN", known[f.sig], f, ""))
        elif f.sig in gone:
            unfixed = [b for b in gone[f.sig] if not fix_on_head(b)]
            if unfixed:
                res.append(("FIXED-UPSTREAM", unfixed, f, "rebase onto the base branch"))
            else:
                res.append(("NEW", [], f, f"regression: the fix for {', '.join(gone[f.sig])} is already on HEAD"))
        else:
            res.append(("NEW", [], f, ""))
    return res


def show_results(res):
    for cls, ids, f, note in res:
        bead = ids[0] if ids else "-"
        also = f" (also {', '.join(ids[1:])})" if len(ids) > 1 else ""
        tail = f"   [{note}]" if note else ""
        print(f"{cls:<15} {bead:<14} {f.sig}{also}{tail}")


def match_exit(res):
    classes = {r[0] for r in res}
    if not res or "NEW" in classes:
        return 1
    return 3 if "FIXED-UPSTREAM" in classes else 0


def summarize(res, scope, n_active):
    count = {c: sum(1 for r in res if r[0] == c) for c in ("KNOWN", "FIXED-UPSTREAM", "NEW")}
    print(f"known-red: {len(res)} failure id(s): {count['KNOWN']} KNOWN, "
          f"{count['FIXED-UPSTREAM']} FIXED-UPSTREAM, {count['NEW']} NEW "
          f"(ledger {scope}: {n_active} open base-red bead(s))", file=sys.stderr)


def no_ids(logname):
    print(f"NEW             -              (no failure id found in {logname})")
    print("known-red: found no failure in this log, so it cannot say the red is known. "
          "Treat it as NEW and read the log.", file=sys.stderr)


# --------------------------------------------------------------------------
# Subcommands
# --------------------------------------------------------------------------

def cmd_sigs(a):
    fails = extract(read_log(a.log), Paths())
    for f in fails:
        print(f.sig)
    return 0 if fails else 1


def cmd_match(a):
    fails = extract(read_log(a.log), Paths())
    if not fails:
        no_ids(a.log)
        return 1
    try:
        scope, active, closed = ledger(True)
        res = classify(fails, active, closed)
    except LookupFailed as e:
        for f in fails:
            print(f"{'NEW':<15} {'-':<14} {f.sig}   [lookup failed]")
        print(f"known-red: LOOKUP FAILED, so every failure is NEW: {e}", file=sys.stderr)
        return 2
    show_results(res)
    summarize(res, scope, len(active))
    return match_exit(res)


def receipt_field(log, key):
    """A gate.sh receipt log sits beside <name>.receipt, which records head= and finished=."""
    if log == "-" or not log.endswith(".log"):
        return None
    try:
        with open(log[:-4] + ".receipt") as fh:
            for line in fh:
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip() or None
    except OSError:
        return None
    return None


def seen_at(a):
    """When the red was seen: --seen-at, else the receipt's finished=, else now."""
    for v in (a.seen_at, receipt_field(a.log, "finished")):
        if v:
            try:
                return datetime.fromisoformat(v.replace("Z", "+00:00")).astimezone(timezone.utc)
            except ValueError:
                raise SystemExit(f"known-red: cannot read {v!r} as a UTC time (want 2026-09-24T19:35:00Z)")
    return NOW


def show_bead(bid):
    data = bd_json(["show", bid, "--json"])
    rec = data[0] if isinstance(data, list) and data else data
    if not isinstance(rec, dict) or not rec.get("id"):
        raise LookupFailed(f"`gc bd show {bid}` returned no bead")
    return rec


def write_meta(bid, kv, add_label, dry):
    args = ["update", bid]
    if add_label:
        args += ["--add-label", LABEL]
    for k, v in kv.items():
        args += ["--set-metadata", f"{k}={v}"]
    if dry:
        print(f"  (dry-run) gc bd {' '.join(repr(x) if ' ' in x or chr(10) in x else x for x in args)}")
        return
    rc, out, err = bd(args)
    if rc != 0:
        raise WriteFailed(f"`gc bd update {bid}` exited {rc}: {err.strip()[:300]}")
    # Read it back. A non-object metadata column freezes every pool create in
    # the rig, and --set-metadata turns number-like values into numbers.
    try:
        rec = show_bead(bid)
    except LookupFailed as e:
        raise WriteFailed(f"cannot read {bid} back after the write: {e}")
    md = rec.get("metadata")
    if not isinstance(md, dict):
        raise WriteFailed(f"{bid}: metadata is a {type(md).__name__}, not an object, after the write. "
                          "Repair it before anything else: a non-object metadata column freezes the rig's pool creates.")
    for k, v in kv.items():
        if md.get(k) != v:
            raise WriteFailed(f"{bid}: metadata.{k} did not round-trip (wrote {v!r}, read {md.get(k)!r})")
    if add_label and LABEL not in (rec.get("labels") or []):
        raise WriteFailed(f"{bid}: label {LABEL} is missing after the write")


def body(fails, a, stamp, log):
    sigs = "\n".join(f"- `{f.sig}`" for f in fails)
    ev = "\n".join(f.evidence for f in fails[:40])
    src = f"\nDiscovered while working {a.from_bead}.\n" if a.from_bead else ""
    return f"""{a.summary}

Filed by `known-red file` from `{log}`. Phase {", ".join(sorted({f.phase for f in fails}))}; seen at {stamp}.
{src}
## Failure ids

`known-red match` keys on these exact ids (metadata `base_red_sigs`). Until this
bead closes, a gate log with only these ids is KNOWN and nobody re-diagnoses it.

{sigs}

## Lifecycle

This bead is the fix bead. Cite its id in the fix commit message: for 7 days after
it closes, `known-red match` reports these ids as FIXED-UPSTREAM (rebase) on any
branch whose history lacks that commit, and as NEW (a regression) on one that has it.

## Failing lines

```
{ev}
```
"""


def cmd_file(a):
    text = read_log(a.log)
    fails = extract(text, Paths())
    if not fails:
        no_ids(a.log)
        return 1
    try:
        scope, active, closed = ledger(True)
        res = classify(fails, active, closed)
        into = show_bead(a.into) if a.into else None
    except LookupFailed as e:
        print(f"known-red: LOOKUP FAILED; filed nothing: {e}", file=sys.stderr)
        return 2
    show_results(res)
    summarize(res, scope, len(active))
    if into and into.get("status") == "closed":
        print(f"known-red: --into {a.into} is closed; filed nothing.", file=sys.stderr)
        return 2

    sha = a.sha or receipt_field(a.log, "head") or git_out(["rev-parse", "HEAD"]) or "unknown"
    seen = seen_at(a)
    stamp = f"{sha}@{utc(seen)}"
    by_id = {b["id"]: b for b in active}
    new = [f for cls, _, f, _ in res if cls == "NEW" and not f.raw]
    raw = [f for cls, _, f, _ in res if f.raw]
    known = []
    for cls, ids, _, _ in res:
        if cls == "KNOWN":
            known += [b for b in ids if b not in known]

    try:
        # KNOWN: move last-seen forward. Metadata, not a note: vn65m piled up
        # 11 repro notes that nobody needed to read.
        for bid in known:
            if into and bid == into["id"] and new:
                continue   # written below together with the new ids
            prev = last_seen(by_id[bid])[1] if bid in by_id else None
            if prev and prev >= seen:
                print(f"known-red: {bid} was already seen at {utc(prev)}; not moving last-seen back")
                continue
            print(f"known-red: {bid} seen again at {stamp}")
            write_meta(bid, {"base_red_last_seen": stamp}, False, a.dry_run)

        if new and into:
            have = bead_sigs(into)
            sigs = have + [f.sig for f in new if f.sig not in have]
            md = meta(into)
            kv = {"base_red_sigs": "\n".join(sigs), "base_red_last_seen": stamp}
            if not md.get("base_red_phase"):
                kv["base_red_phase"] = a.phase or ",".join(sorted({f.phase for f in new}))
            if not md.get("base_red_first_sha"):
                kv["base_red_first_sha"] = sha
            if a.from_bead and not md.get("base_red_from"):
                kv["base_red_from"] = a.from_bead
            print(f"known-red: recording {len(new)} new id(s) on {into['id']}")
            write_meta(into["id"], kv, True, a.dry_run)
        elif new:
            first = new[0].sig if len(new[0].sig) <= 120 else new[0].sig[:119] + "…"
            more = f" (+{len(new) - 1} more)" if len(new) > 1 else ""
            ttl = f"Pre-existing failure: {first}{more} — {a.summary}"
            ttl = ttl if len(ttl) <= 240 else ttl[:239] + "…"
            with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as fh:
                fh.write(body(new, a, stamp, a.log))
                body_file = fh.name
            args = ["create", "--type", "bug", "-p", "1", "--labels", LABEL,
                    "--title", ttl, "--body-file", body_file, "--silent"]
            if a.dry_run:
                print(f"  (dry-run) gc bd create --type bug -p 1 --labels {LABEL} --title {ttl!r} --body-file <{len(new)} ids>")
                bid = "<new>"
            else:
                rc, out, err = bd(args)
                lines = out.strip().splitlines()
                bid = lines[-1].strip() if lines else ""
                if rc != 0 or not re.fullmatch(r"[A-Za-z0-9]+-[A-Za-z0-9.]+", bid):
                    raise WriteFailed(
                        f"`gc bd create` exited {rc} ({(err or out).strip()[:200]}). A create can land and still "
                        f"fail here: run `known-red list` before filing again, or you file a duplicate.")
            os.unlink(body_file)
            print(f"known-red: filed {bid} for {len(new)} new id(s)")
            kv = {"base_red_sigs": "\n".join(f.sig for f in new),
                  "base_red_phase": a.phase or ",".join(sorted({f.phase for f in new})),
                  "base_red_first_sha": sha,
                  "base_red_last_seen": stamp}
            if a.from_bead:
                kv["base_red_from"] = a.from_bead
            write_meta(bid, kv, False, a.dry_run)
    except (WriteFailed, LookupFailed) as e:
        print(f"known-red: WRITE FAILED: {e}", file=sys.stderr)
        return 2

    for cls, ids, f, _ in res:
        if cls == "FIXED-UPSTREAM":
            print(f"known-red: {f.sig} is fixed upstream by {ids[0]}; rebase, there is nothing to file")
    if raw:
        print(f"known-red: {len(raw)} failure line(s) have no stable id, so known-red could never match "
              "them later and does not file them. Quote them on your work bead and report the gap, "
              "so the extractor gains a rule:", file=sys.stderr)
        for f in raw:
            print(f"  {f.sig}", file=sys.stderr)
        return 1
    return 0


def last_seen(bead):
    v = meta(bead).get("base_red_last_seen")
    if isinstance(v, str) and "@" in v:
        sha, ts = v.rsplit("@", 1)
        try:
            return sha, datetime.fromisoformat(ts.replace("Z", "+00:00"))
        except ValueError:
            pass
    try:
        return None, datetime.fromisoformat(str(bead.get("created_at", "")).replace("Z", "+00:00"))
    except ValueError:
        return None, None


def age(ts):
    if ts is None:
        return "never"
    h = (NOW - ts).total_seconds() / 3600
    return f"{h:.0f}h" if h < 72 else f"{h / 24:.1f}d"


def cmd_list(a):
    try:
        scope, active, _ = ledger(False)
    except LookupFailed as e:
        print(f"known-red: LOOKUP FAILED: {e}", file=sys.stderr)
        return 2
    rows = []
    for b in sorted(active, key=lambda x: x["id"]):
        phases = [p for p in str(meta(b).get("base_red_phase", "")).split(",") if p]
        if a.phase and a.phase not in phases:
            continue
        sha, ts = last_seen(b)
        stale = ts is None or NOW - ts > STALE_AFTER
        if a.stale and not stale:
            continue
        rows.append((b, phases, sha, ts, stale))
    n_stale = sum(1 for r in rows if r[4])
    print(f"known-red: {len(rows)} base-red bead(s) in ledger {scope} "
          f"(statuses {','.join(ACTIVE_STATUSES)}{', phase ' + a.phase if a.phase else ''}); "
          f"{n_stale} STALE (unseen >{int(STALE_AFTER.total_seconds() // 3600)}h)")
    for b, phases, sha, ts, stale in rows:
        at = f" @{sha[:8]}" if sha else ""
        print(f"{b['id']:<14} {b.get('status', '?'):<11} P{b.get('priority', '?')}  "
              f"phase={','.join(phases) or '?'}  last seen {age(ts)} ago{at}{'  STALE' if stale else ''}")
        sigs = bead_sigs(b)
        for s in sigs:
            print(f"    {s}")
        if not sigs:
            print(f"    (no base_red_sigs: nothing can match this bead; add them with "
                  f"`known-red file <log> --summary ... --into {b['id']}`)")
    if n_stale:
        print("STALE: re-run just that id on the current base. If it no longer reproduces, close the bead "
              "\"no longer reproduces at <sha>\". Nothing auto-closes: a flake that did not fire is not fixed.")
    return 0


def main(argv):
    p = argparse.ArgumentParser(prog="known-red", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("list", help="open base-red beads in this directory's ledger")
    s.add_argument("--phase")
    s.add_argument("--stale", action="store_true", help="only beads unseen for 72h")
    s = sub.add_parser("match", help="classify each failure in a gate log")
    s.add_argument("log")
    s = sub.add_parser("file", help="match, then record: refresh KNOWN, file NEW")
    s.add_argument("log")
    s.add_argument("--summary", required=True)
    s.add_argument("--from", dest="from_bead")
    s.add_argument("--into", help="record new ids on this existing bead instead of creating one")
    s.add_argument("--phase")
    s.add_argument("--sha", help="base SHA the red was seen on (default: the receipt's head=, else HEAD)")
    s.add_argument("--seen-at", help="UTC time it was seen (default: the receipt's finished=, else now)")
    s.add_argument("--dry-run", action="store_true")
    s = sub.add_parser("sigs", help="print the failure ids in a gate log (no lookup)")
    s.add_argument("log")
    a = p.parse_args(argv)
    try:
        return {"list": cmd_list, "match": cmd_match, "file": cmd_file, "sigs": cmd_sigs}[a.cmd](a)
    except OSError as e:
        print(f"known-red: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
